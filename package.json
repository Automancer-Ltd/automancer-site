{
  "name": "automancer-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepare": "astro sync",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --type-aware --deny-warnings src tests public/assets/js",
    "typecheck": "test -f .astro/content.d.ts || astro sync; tsrs --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && if [ -f dist/index.html ]; then SKIP_BUILD=1 vitest run; else SKIP_BUILD=1 vitest run tests/storage-sentinel.test.ts; fi",
    "test": "vitest run",
    "test:watch": "vitest",
    "journey": "playwright test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sentry/browser": "^11.10.0",
    "astro": "^7.4.10",
    "node-html-parser": "^9.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "^5.0.5"
  }
}
