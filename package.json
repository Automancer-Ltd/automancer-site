{
  "name": "automancer-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "astro sync",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --type-aware --deny-warnings src tests public/assets/js",
    "typecheck": "test -f .astro/content.d.ts || astro sync; tsrs --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && if [ -f dist/index.html ]; then SKIP_BUILD=1 vitest run; else SKIP_BUILD=1 vitest run tests/storage-sentinel.test.ts; fi",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sentry/browser": "^11.8.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.3",
    "node-html-parser": "^9.0.4",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
