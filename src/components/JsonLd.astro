---
/**
 * Renders one JSON-LD <script> containing a single @graph built from the
 * given nodes (see src/data/jsonld.ts for the builders). Every page's graph
 * includes the shared Organization + WebSite nodes plus its own page node,
 * cross-referenced by absolute-URL @id.
 */
export interface Props {
  nodes: Record<string, unknown>[];
}

const { nodes } = Astro.props;
const json = {
  '@context': 'https://schema.org',
  '@graph': nodes,
};
---

{/* `<` as \u003c: a "</script>" in any content string would otherwise end the
    block and run what follows. JSON parsers read it back as the same character. */}
<script type="application/ld+json" is:inline set:html={JSON.stringify(json).replace(/</g, '\\u003c')} />
