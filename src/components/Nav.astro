---
const navLinks = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
const mobileLinks = [{ href: '/', label: 'Home' }, ...navLinks];
const mobileCurrent = (href: string) => {
  if (currentPath === href) return 'page';
  if (href !== '/' && isActive(href)) return 'location';
  return undefined;
};
---

<header class="nav" role="banner">
  <a href="/" class="nav__brand" aria-label="Automancer — home">
    <img src="/assets/images/logo.svg" alt="" role="presentation" class="nav__mark" width="30" height="34" />
    <span class="nav__wordmark">Automancer</span>
  </a>

  <nav class="nav__links" aria-label="Primary">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="nav__link"
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        {link.label}
        {isActive(link.href) && <span class="nav__current" aria-hidden="true"></span>}
      </a>
    ))}
    <a href="/contact/" class="btn btn--sm"><span>Contact</span></a>
  </nav>

  <div class="nav__actions">
    <a href="/contact/" class="nav__contact" aria-current={mobileCurrent('/contact/')}>Contact</a>
    <details class="nav__disclosure">
      <summary class="nav__toggle" aria-controls="mobile-menu">Menu</summary>
      <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile menu">
        {mobileLinks.map((link) => (
          <a href={link.href} class="mobile-menu__link" aria-current={mobileCurrent(link.href)}>{link.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
