---
/**
 * An article's contents: one link per section (its <h2>), with that section's
 * <h3> parts nested beneath it, so a reader can see the shape of a long field
 * note or case study and jump to the part they came for.
 *
 * Two forms of the same list, chosen by width in the styles below: `inline` is a closed disclosure above the first paragraph on
 * phones and tablets; `rail` sits beside the text on wide screens. Both stay in
 * view while reading: the rail beside the text, the disclosure as a bar under
 * the fixed nav that names the part being read and where it falls ("4/7"), and
 * opens over the text (t25430). src/scripts/main.ts marks the part being read
 * (aria-current), fills the bar, and closes it after a jump; CSS lights the
 * section that holds the part.
 *
 * The list repeats the page's own headings, so it is not counted as the page's
 * words (data-page-words="skip", src/integrations/page-dates.ts): adding it
 * changes no page's date.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'inline' | 'rail';
  /** What the closed list counts: its sections ("sections"), or on /releases its months. */
  unit?: string;
}

const { headings, variant, unit = 'sections' } = Astro.props;
// Each h2 with the h3s that follow it; an h3 before the first h2 has no section to sit in.
const sections: { head: MarkdownHeading; parts: MarkdownHeading[] }[] = [];
for (const h of headings) {
  if (h.depth === 2) sections.push({ head: h, parts: [] });
  else if (h.depth === 3) sections.at(-1)?.parts.push(h);
}
---

{sections.length >= 3 && (
  variant === 'inline' ? (
    <details class="toc toc--inline" data-toc data-page-words="skip">
      <summary>
        <span class="toc__label">On this page</span>
        <span class="toc__count">{sections.length} {unit}</span>
        <span class="toc__now" aria-hidden="true" data-toc-now></span>
        <span class="toc__step" aria-hidden="true" data-toc-step></span>
      </summary>
      <ol>
        {sections.map(({ head, parts }) => (
          <li>
            <a href={`#${head.slug}`}>{head.text}</a>
            {parts.length > 0 && <ol>{parts.map((p) => <li><a href={`#${p.slug}`}>{p.text}</a></li>)}</ol>}
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <nav class="toc toc--rail" aria-label="On this page" data-toc data-page-words="skip">
      <p class="toc__label" aria-hidden="true">On this page</p>
      <ol>
        {sections.map(({ head, parts }) => (
          <li>
            <a href={`#${head.slug}`}>{head.text}</a>
            {parts.length > 0 && <ol>{parts.map((p) => <li><a href={`#${p.slug}`}>{p.text}</a></li>)}</ol>}
          </li>
        ))}
      </ol>
    </nav>
  )
)}

<style is:global>
.toc__label, .toc__count { font-family: var(--font-mono); font-size: .72rem; color: var(--faint); }
.toc__label { font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
.toc ol { list-style: none; padding: 0; }
.toc a { display: block; padding-block: var(--sp-2); font-family: var(--font-ui); line-height: 1.4; text-wrap: pretty; color: var(--muted); transition: color var(--dur-1); }
.toc a:hover, .toc a[aria-current] { color: var(--white); }
/* A section's parts sit indented under it; the section holding the part being read stays lit. */
.toc ol ol a { padding-left: var(--sp-4); font-size: .9em; }
.toc li:has(> ol a[aria-current]) > a { color: var(--white); }
/* Phones and tablets: a bar the width of the screen that stays under the fixed
   nav (--nav-h, measured by main.ts) while the article is read, and leaves with
   the article. Its list opens over the text rather than pushing it down, so the
   page under the reader does not move. A screen too short to spare the bar
   (a phone on its side) keeps it in place above the text. */
.toc--inline { position: relative; z-index: calc(var(--z-nav) - 1);
  margin: 0 calc(-1 * var(--pad-x)) clamp(1.75rem, 4vw, 2.5rem); padding-inline: var(--pad-x);
  background: var(--bg);
  border-bottom: 1px solid var(--border); }
/* A part's heading then lands below the nav and the bar, not under them. */
@media (width < 64rem) and (height >= 30rem) {
  .toc--inline { position: sticky; top: var(--nav-h, 4.3rem); }
  .article-layout:has(> .toc--inline) [id] { scroll-margin-top: calc(var(--nav-h, 4.3rem) + 3.75rem); }
}
.toc--inline > summary, .toc--inline > ol > li { max-width: var(--w-read); }
.toc--inline > ol { position: absolute; inset: 100% 0 auto; padding: var(--sp-2) var(--pad-x) var(--sp-4);
  max-height: calc(100dvh - var(--nav-h, 4.3rem) - 3.75rem); overflow-y: auto; overscroll-behavior: contain;
  scrollbar-width: thin; background: var(--near); border-bottom: 1px solid var(--border-strong);
  box-shadow: 0 1.5rem 2.5rem -1rem rgba(0,0,0,.85); }
/* Once a part is being read, the bar names it, and where it falls among the
   sections, in place of the label and the count (kept for screen readers). */
.toc__now { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  font-family: var(--font-ui); font-size: .9375rem; color: var(--ink); }
.toc__step { font-family: var(--font-mono); font-size: .72rem; color: var(--faint); font-variant-numeric: tabular-nums; }
.toc__now:empty, .toc__step:empty { display: none; }
.toc--inline[data-at] :is(.toc__label, .toc__count) { position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip-path: inset(50%); white-space: nowrap; }
.toc summary { display: flex; align-items: center; gap: var(--sp-4); min-height: 2.75rem; cursor: pointer; list-style: none; }
.toc summary::-webkit-details-marker { display: none; }
.toc summary::after { content: ""; margin-inline-start: auto; width: .5rem; height: .5rem;
  border: solid var(--faint); border-width: 0 1.5px 1.5px 0; rotate: 45deg; translate: 0 -25%; transition: rotate var(--dur-2); }
.toc[open] summary::after { rotate: 225deg; translate: 0 25%; }
.toc--rail { display: none; }
@media (min-width: 64rem) {
  .article-layout { display: grid; grid-template-columns: minmax(0, var(--w-read)) minmax(12rem, 16rem);
    column-gap: clamp(3rem, 6vw, 6rem); justify-content: space-between; align-items: start; }
  .article-layout > :not(.toc) { grid-column: 1; }
  .toc--inline { display: none; }
  .toc--rail { display: block; grid-area: 1 / 2 / span 2; position: sticky; top: 6.5rem; padding-top: .45rem;
    max-height: calc(100dvh - 8.5rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .toc--rail ol { margin-top: var(--sp-4); border-left: 1px solid var(--border); }
  .toc--rail a { margin-left: -1px; padding-left: var(--sp-5); border-left: 1px solid transparent; font-size: .875rem; }
  .toc--rail a[aria-current] { border-left-color: var(--spec-5); }
  .toc--rail ol ol { margin-top: 0; border-left: 0; }
  .toc--rail ol ol a { margin-left: -1px; padding-block: var(--sp-1); padding-left: calc(var(--sp-5) + var(--sp-4)); font-size: .8125rem; }
  .toc--rail ol ol li:last-child a { padding-bottom: var(--sp-2); }
}
</style>
