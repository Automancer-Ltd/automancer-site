---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatGBP, serviceById } from '../data/business';

const auditFrom = formatGBP(serviceById('automation-opportunity-audit').priceFrom);

const principles = [
  { name: 'Sensible prices, published', desc: 'Our starting prices are on the website so you can see them before you get in touch.' },
  { name: 'A human in the loop, always', desc: 'Agents do the work; Waseem makes the decisions and takes the calls. We promise a meeting within one week of first contact.' },
  { name: 'Built properly, not prototyped', desc: 'Audited, monitored, backed up, and tested to the same standard as our own systems.' },
  { name: 'Staged, checked delivery', desc: 'You see each part working in a test environment before it goes live.' },
  { name: 'Remote-first, Bradford-rooted', desc: 'Based in Bradford and working with businesses in Leeds, Manchester, and across the UK.' },
];
---

<BaseLayout
  title="About"
  description="An AI-run consultancy with a human at the helm. Automancer's finance, project tracking and website run on agents — every decision taken by Waseem, in Bradford."
>
  <section class="page-hero hatch">
    <div class="page-hero__glow" aria-hidden="true" data-px="26"></div>
    <div class="page-hero__inner">
      <p class="eyebrow">About Automancer</p>
      <h1 class="page-hero__title">An AI-run business, with a human at the helm.</h1>
      <p class="page-hero__sub">
        Automancer runs its own finance tracking, project management, and website on AI agents.
        Waseem makes every decision and takes every call.
      </p>
    </div>
  </section>

  <!-- Why Automancer -->
  <section class="section on-near">
    <div class="wrap">
      <div class="story">
        <div class="story__aside"><span class="story__tag">01 · the name</span><h2>Why "Automancer"?</h2></div>
        <div class="story__body">
          <p>
            An automancer works magic through machines. That's the joke, and it's also the job
            description. When systems talk to each other and repetitive admin happens overnight, it
            feels like magic. In practice, it is careful software engineering pointed at the dullest,
            most expensive jobs in your week.
          </p>
          <p>
            For years, custom automation required a six-figure budget and an internal IT department.
            Smaller businesses had to make do with disconnected apps and spreadsheets. Better tools
            now make it affordable for a care provider in Bradford or a manufacturer in Manchester to
            have software built around their exact workflow.
          </p>
          <p>We built Automancer to deliver that — and we run our own consultancy on the same tools we build for clients.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The business is the demo -->
  <section class="section on-paper">
    <div class="wrap">
      <div class="story">
        <div class="story__aside"><span class="story__tag">02 · the demo</span><h2>The business is the demo.</h2></div>
        <div class="story__body">
          <p>Here is how Automancer runs day to day.</p>
          <p>
            AI agents monitor software spend and draft invoices. Waseem checks, approves, and sends
            them. Bookkeeping stays manual. Agents track every project, run automated checks on every
            change, and maintain this website and its field notes.
          </p>
          <p>
            One rule never changes: <strong>a human makes every decision and takes every call.</strong>
            The agents draft, calculate, monitor, and test. Waseem decides what ships, approves every
            invoice, and speaks directly with every client.
          </p>
          <p>
            Running our own back office this way keeps our overheads low and proves our tools in
            daily use before we put them to work for you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waseem -->
  <section class="section on-dark hatch">
    <div class="wrap">
      <div class="story">
        <div class="story__aside"><span class="story__tag">03 · the human</span><h2>Meet Waseem.</h2></div>
        <div class="story__body">
          <p>
            Automancer is founded and run by Waseem Ilyas, an engineer who builds software that takes
            repetitive admin off small teams.
          </p>
          <p>
            Before starting Automancer, he founded and ran a SaaS product company from scratch. He
            brings that production discipline — automated testing, monitoring, and verified backups —
            to every client project.
          </p>
          <p>
            He works with businesses across social care, manufacturing, professional services, and
            travel, from a ~600-person care provider's operations platform to a single-page site for a
            new travel agency.
          </p>
          <p>
            When you contact Automancer, you deal directly with Waseem. He reads your enquiry, scopes
            your project, and takes every call.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">How we do things</p>
          <span class="section-head__log">// rules_kept: 5/5</span>
        </div>
        <h2>Five rules we actually keep.</h2>
      </div>
      <div class="principles reveal-stagger">
        {principles.map((p, i) => (
          <div class="principle" data-spot>
            <span class="principle__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section on-dark cta hatch">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="cta__head">Want a business that runs a bit more like ours?</h2>
      <p class="cta__body">
        Start with an Audit and we'll show you where AI and automation will save time and money in
        your business, with clear numbers and a practical plan.
      </p>
      <div class="cta__ctas">
        <a href="/contact/" class="btn"><span>Book an Audit — from {auditFrom}</span></a>
        <a href="/work/" class="btn btn--ghost"><span>See the work</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
