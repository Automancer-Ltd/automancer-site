---
import type { MarkdownHeading } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/prose.css';
import '../styles/releases.css';
import SpectrumGlow from '../components/SpectrumGlow.astro';
import ArticleContents from '../components/ArticleContents.astro';
import { getReleases, type Release } from '../data/releases';
import { staticPages } from '../data/site-content';

const meta = staticPages.find((page) => page.path === '/releases/')!;
const releases = await getReleases();

// Newest first, as the changelog keeps them: each month holds its days, each
// day its releases. The ids are the date (2026-11, 2026-11-21); each release
// keeps its version as its id, the anchor /api/releases.json publishes.
interface Day { id: string; displayDate: string; short: string; releases: Release[] }
interface Month { id: string; label: string; days: Day[]; count: number }
const months: Month[] = [];
for (const r of releases) {
  const monthId = r.date.slice(0, 7);
  let month = months.at(-1);
  if (month?.id !== monthId) {
    month = { id: monthId, label: r.displayDate.replace(/^\d+ /, ''), days: [], count: 0 };
    months.push(month);
  }
  let day = month.days.at(-1);
  if (day?.id !== r.date) {
    day = { id: r.date, displayDate: r.displayDate, short: r.displayDate.replace(/ \d{4}$/, ''), releases: [] };
    month.days.push(day);
  }
  day.releases.push(r);
  month.count++;
}

const headings: MarkdownHeading[] = months.flatMap((m) => [
  { depth: 2, slug: m.id, text: m.label },
  ...m.days.map((d) => ({ depth: 3, slug: d.id, text: d.short })),
]);

// A release's own parts ("Improvements", "Fixes") sit under its day's heading.
const notesHtml = (html: string) => html.replace(/<(\/?)h3\b/g, '<$1h4');
const plural = (n: number) => `${n} release${n === 1 ? '' : 's'}`;
---

<BaseLayout title={meta.title} description={meta.description} pageType={meta.type}>
  <section class="page-hero hatch">
    <SpectrumGlow class="page-hero__glow" px={26} />
    <div class="page-hero__inner">
      <p class="eyebrow">Release notes</p>
      <h1 class="page-hero__title">What changed on this site, and when.</h1>
      <p class="page-hero__sub">
        Every release, newest first, from the same record we keep for ourselves. Machines can read
        the same notes at <a class="tlink" href="/api/releases.json">/api/releases.json</a> or as
        Markdown at <a class="tlink" href="/releases.md">/releases.md</a>.
      </p>
    </div>
  </section>

  <section class="section on-dark">
    <div class="wrap article-layout">
      <ArticleContents headings={headings} variant="inline" unit="months" />
      <div class="releases">
        {months.map((m) => (
          <section class="rel-month" aria-labelledby={m.id}>
            <h2 id={m.id} class="rel-month__title">
              {m.label} <span class="rel-month__count" data-page-words="skip">{plural(m.count)}</span>
            </h2>
            {m.days.map((d) => (
              <section class="rel-day" aria-labelledby={d.id}>
                <h3 id={d.id} class="rel-day__date"><time datetime={d.id}>{d.displayDate}</time></h3>
                {d.releases.map((r) => (
                  <article id={r.version} class="rel" aria-label={`Release ${r.version}`}>
                    <a class="rel__version" href={`#${r.version}`}>{r.version}</a>
                    <div class="prose rel__notes"><Fragment set:html={notesHtml(r.html)} /></div>
                  </article>
                ))}
              </section>
            ))}
          </section>
        ))}
      </div>
      <ArticleContents headings={headings} variant="rail" />
    </div>
  </section>
</BaseLayout>
