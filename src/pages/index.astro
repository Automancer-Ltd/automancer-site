---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/hero.css';
import '../styles/case-cards.css';
import Bead from '../components/Bead.astro';
import SpectrumGlow from '../components/SpectrumGlow.astro';
import { getCollection } from 'astro:content';
import { formatGBP, serviceById, serviceOfferAnchor } from '../data/business';
import { contactHref } from '../data/enquiry';
import { staticPages } from '../data/site-content';
import { serviceCatalogNode } from '../data/jsonld';

const audit = serviceById('automation-opportunity-audit');
const sprint = serviceById('workflow-implementation-sprint');
const systemBuild = serviceById('system-agent-build');
const ops = serviceById('ai-ops-partner');
const homeDescription = staticPages.find((page) => page.path === '/')!.description;

const isProd = import.meta.env.PROD;
const studies = (await getCollection('case-studies'))
  .filter((e) => !(isProd && e.data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const feature = studies.find((e) => e.data.featured) ?? studies[0];
const rest = studies.filter((e) => e.id !== feature?.id).slice(0, 2);

const ladder = [
  { service: audit, description: "We map where your time and money are leaking, and hand you a costed plan. Fee credited against any project you go on to do." },
  { service: sprint, description: '1–3 automations live in roughly two weeks.' },
  { service: systemBuild, description: 'A custom system or AI agent, built to last.' },
  { service: ops, description: 'We run it, watch it, and keep automating. Cancel anytime.' },
];

const caps = [
  { name: 'Workflow automation', desc: 'Repetitive admin across your existing tools, connected into one reliable flow.' },
  { name: 'Custom systems & portals', desc: 'Software built around how your team works, rather than forcing you into an off-the-shelf template.' },
  { name: 'AI agents', desc: 'Software that reads, drafts, and acts while a person stays in control of every important decision.' },
  { name: 'AI Ops partnership', desc: 'We stay on, keep your systems running, and automate the next job. Cancel anytime.' },
];
---

<BaseLayout
  title="AI & automation for UK small businesses"
  description={homeDescription}
  schema={[serviceCatalogNode()]}
>
  <!-- ─────────────── Hero ─────────────── -->
  <section class="hero hatch">
    <div class="hero__glow" aria-hidden="true">
      <SpectrumGlow class="hero__orb hero__orb--a" px={34} />
      <SpectrumGlow class="hero__orb hero__orb--b" cycle="b" px={-22} />
    </div>
    <div class="hero__inner">
      <p class="eyebrow eyebrow--live"><Bead />AI &amp; automation consultancy · Bradford → UK-wide</p>
      <h1 class="hero__headline">Your admin, automated into <span class="spectral-text">oblivion</span>.</h1>
      <p class="hero__reveal">We make small businesses run like magic.</p>
      <p class="hero__body">
        Automancer builds the software and AI agents that handle the repetitive, error-prone admin
        your team shouldn't be doing by hand. Real systems, published prices, and a human who answers.
      </p>
      <p class="hero__terminal">
        <span class="sr-only">It's not magic. It's very good engineering.</span>
        <span class="prompt" aria-hidden="true">&gt;_ </span><span aria-hidden="true">It's not magic. It's very good engineering.</span><span class="hero__caret" aria-hidden="true"></span>
      </p>
      <div class="hero__ctas">
        <a href={contactHref('automation-opportunity-audit')} class="btn"><span>Book an Automation Audit — from {formatGBP(audit.priceFrom)}</span></a>
        <a href="/work/" class="btn btn--ghost"><span>See the work</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
    <div class="hero__cue" aria-hidden="true"></div>
    <div class="hero__fold" aria-hidden="true"></div>
  </section>

  <section class="section section--tight on-dark hatch" aria-labelledby="starting-prices">
    <div class="wrap pricing">
      <div class="pricing__intro">
        <h2 id="starting-prices">Clear starting prices, upfront.</h2>
        <p>We publish our starting prices so you know what to expect before you get in touch.</p>
        <a href="/services/" class="arrow-link">Compare all services <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="ladder">
        {ladder.map(({ service, description }) => (
          <a class="rung" href={`/services/#${serviceOfferAnchor(service.id)}`} aria-labelledby={`price-link-${service.id}`}>
            <h3 class="rung__name" id={`price-link-${service.id}`}>{service.name}</h3>
            <p class="rung__price">
              <span class="from">from</span>
              <span class="amt">{formatGBP(service.priceFrom)}</span>
              {service.priceUnit === 'month' && <span class="unit">/mo</span>}
            </p>
            <p class="rung__desc">{description}</p>
            <svg class="rung__arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────── Meta-story / proof ─────────────── -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="section-head__top">
          <p class="eyebrow">The proof is the business you're looking at</p>
          <span class="section-head__log">// proof.log — live</span>
        </div>
        <h2>This whole company is run by AI. On purpose.</h2>
        <p>
          Our own finance tracking, project management, website, and field notes run on AI agents.
          Waseem makes every decision and takes every call. The agents handle the routine work;
          the judgement stays human.
        </p>
      </div>

      <div class="proof-grid reveal-stagger">
        {[
          { n: '01', tag: 'finance', h: 'Monitored, not automated', p: 'Agents monitor software spend and draft invoices. Waseem approves and sends them. Bookkeeping stays manual.' },
          { n: '02', tag: 'delivery', h: 'Tracked end to end', p: 'Agents track every project and check each release before Waseem signs it off for a client.' },
          { n: '03', tag: 'content', h: 'This site & blog', p: "Written, built, and maintained by the same agents we put to work in your business." },
          { n: '04', tag: 'control', h: 'One human in the loop', p: 'Every decision and every call goes through Waseem. No call centre and no ticket queue.' },
        ].map((c) => (
          <div class="proof-cell" data-spot>
            <span class="ghost-num" aria-hidden="true">{c.n}</span>
            <span class="proof-cell__n">{c.tag}</span>
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </div>
        ))}
      </div>

      <blockquote class="pullquote reveal" style="margin-top: clamp(3rem, 6vw, 5rem);">
        We build your systems using <span class="spectral-text">the same tools we run our own company on</span>.
      </blockquote>
    </div>
  </section>

  <!-- ─────────────── What we do ─────────────── -->
  <section class="section on-paper">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">What we do</p>
          <span class="section-head__log">// capabilities: 4</span>
        </div>
        <h2>We automate the work that's eating your week.</h2>
        <p>
          If someone on your team spends hours copying figures between systems, updating spreadsheets,
          chasing approvals, or answering the same question every day, a computer can do that job for them.
        </p>
      </div>
      <ol class="cap-list reveal">
        {caps.map((c, i) => (
          <li class="cap-row">
            <span class="cap-row__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cap-row__name">{c.name}</span>
            <span class="cap-row__desc">{c.desc}</span>
          </li>
        ))}
      </ol>
      <p style="margin-top: var(--sp-10)">
        <a href="/services/" class="arrow-link">Not sure what to automate first? Start with an Audit <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- ─────────────── Selected work ─────────────── -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2>Real businesses. Real systems. Live in production.</h2>
      </div>
      <div class="case-grid case-grid--pair">
        {feature && (
          <a href={`/work/${feature.id}/`} class="case-card case-card--feature" data-spot>
            <span class="case-card__tag">{feature.data.sector}{feature.data.status ? ` · ${feature.data.status}` : ''}</span>
            <h3 class="case-card__title">{feature.data.title}</h3>
            <p class="case-card__blurb">{feature.data.summary ?? feature.data.description}</p>
            <div class="case-card__foot">
              <span class="arrow-link">Read the case study <span class="btn__arrow">→</span></span>
            </div>
          </a>
        )}
        {rest.map((e) => (
          <a href={`/work/${e.id}/`} class="case-card" data-spot>
            <span class="case-card__tag">{e.data.sector}</span>
            <h3 class="case-card__title">{e.data.title}</h3>
            <p class="case-card__blurb">{e.data.summary ?? e.data.description}</p>
            <div class="case-card__foot">
              <span class="arrow-link">Read <span class="btn__arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top: var(--sp-10)">
        <a href="/work/" class="arrow-link">See all our work <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- ─────────────── Agents & developers ─────────────── -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">For agents &amp; developers</p>
        <h2>This site speaks machine, too.</h2>
        <p>
          Every fact here is also available as data: a public, read-only JSON API that needs no
          authentication, Markdown twins of every page, full-text files written for LLMs, and an
          OpenAPI spec of it all.
        </p>
      </div>
      <div class="cta__ctas" style="margin-top: var(--sp-8); justify-content: flex-start">
        <a href="/developers/" class="btn"><span>Developer &amp; agent documentation</span></a>
        <a href="/llms.txt" class="btn btn--ghost"><span>Read llms.txt</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ─────────────── Final CTA ─────────────── -->
  <section class="section on-dark cta hatch">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="cta__head">Tell us what's eating your week.</h2>
      <p class="cta__body">
        Fill in a short form. No calendar gauntlet, no chatbot, no sales sequence. Waseem reads it
        himself and emails you back — and we promise a meeting within one week of first contact.
      </p>
      <div class="cta__ctas">
        <a href={contactHref('automation-opportunity-audit')} class="btn"><span>Start with an Audit — from {formatGBP(audit.priceFrom)}</span></a>
        <a href="/contact/" class="btn btn--ghost"><span>Just ask a question</span><span class="btn__arrow">→</span></a>
      </div>
      <p class="cta__reassure">
        Based in Bradford. Working with businesses in Leeds, Manchester and across the UK, remote-first.
      </p>
    </div>
  </section>
</BaseLayout>

<style is:global>
/* ─────────────────────── Proof grid (home meta-story) ─────────────────────── */
.proof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px;
  background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
.proof-cell {
  background: radial-gradient(480px circle at var(--mx) var(--my), rgba(255,255,255,0.05), transparent 45%), var(--near);
  padding: clamp(1.5rem, 3vw, 2.25rem); display: flex; flex-direction: column; gap: var(--sp-3);
  transition: background-color var(--dur-2); position: relative;
}
.proof-cell:hover { background-color: var(--g-900); }
.proof-cell:hover .ghost-num { color: var(--g-400); }
.proof-cell .ghost-num { font-size: clamp(2.6rem, 2rem + 2vw, 4rem); }
.proof-cell__n { font-family: var(--font-mono); font-size: 0.72rem; color: var(--faint); letter-spacing: 0.1em; }
.proof-cell h3 { font-family: var(--font-display); font-size: var(--t-1); font-weight: 700; }
.proof-cell p { color: var(--muted); font-size: var(--t-0); }

/* ─────────────────────── Capability rows ─────────────────────── */
.cap-list { border-top: 1px solid var(--border-dark); }
.on-dark .cap-list, .on-near .cap-list { border-top-color: var(--border); }
.cap-row {
  display: flex; flex-wrap: wrap; gap: var(--sp-3) clamp(1.5rem, 3vw, 2.5rem);
  padding-block: clamp(1.5rem, 3vw, 2.25rem); border-bottom: 1px solid var(--border-dark);
  align-items: baseline;
}
.on-dark .cap-row, .on-near .cap-row { border-bottom-color: var(--border); }
.cap-row__n { font-family: var(--font-display); font-weight: 800; line-height: 1;
  font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); color: var(--ghost-paper); flex: 0 0 2.3em; }
.on-dark .cap-row__n, .on-near .cap-row__n { color: var(--border-strong); }
.cap-row__name { font-family: var(--font-display); font-size: var(--t-2); font-weight: 700; letter-spacing: -0.03em;
  flex: 0 1 22ch; min-width: min(100%, 16rem); }
.cap-row__desc { color: var(--muted-dark); font-size: var(--t-0); flex: 1 1 20rem; line-height: 1.6; }
.on-dark .cap-row__desc, .on-near .cap-row__desc { color: var(--muted); }

/* Starting prices are available on the first scroll, even without a reveal script. */
.pricing {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 25rem), 1fr));
  align-items: start;
  gap: clamp(1.5rem, 4vw, 4rem);
}
.pricing__intro h2 {
  font-size: var(--t-section);
  line-height: 1.05;
  letter-spacing: -0.035em;
  text-wrap: balance;
  max-inline-size: 14ch;
}
.pricing__intro p { color: var(--muted); max-inline-size: 36ch; margin-block: var(--sp-4); }
.ladder { container-type: inline-size; border-block-start: 1px solid var(--border-strong); }
.rung {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas: "name arrow" "price arrow" "desc desc";
  gap: var(--sp-2) var(--sp-3);
  align-items: baseline;
  padding: var(--sp-4) clamp(.5rem, 2vw, 1.25rem);
  border-block-end: 1px solid var(--border-strong);
}
.rung:focus-visible { outline-offset: -2px; }
.rung:active, .rung:focus-visible { background-color: var(--near); }
@media (hover: hover) and (pointer: fine) {
  .rung:hover { background-color: var(--near); }
  .rung:hover .rung__name { text-decoration: underline; text-underline-offset: .18em; }
}
.rung__name { grid-area: name; font-size: var(--t-1); line-height: 1.2; }
.rung__desc { grid-area: desc; color: var(--muted); max-inline-size: 52ch; }
.rung__price {
  grid-area: price;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: .25em;
  font-family: var(--font-mono);
  font-size: .8125rem;
  color: var(--muted);
}
.rung__price .amt { color: var(--white); font-size: var(--t-1); line-height: 1; }
.rung__arrow { grid-area: arrow; align-self: center; color: var(--g-200); }
@container (min-width: 28rem) {
  .rung {
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas: "name price arrow" "desc desc desc";
  }
}

/* ─────────────────────── Pull quote ─────────────────────── */
.pullquote { font-family: var(--font-display); font-weight: 600; font-size: var(--t-3);
  letter-spacing: -0.03em; line-height: 1.2; max-width: 34ch; text-wrap: balance; }
</style>
