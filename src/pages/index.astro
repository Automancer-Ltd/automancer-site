---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatGBP, serviceById } from '../data/business';
import { staticPages } from '../data/site-content';
import { serviceCatalogNode } from '../data/jsonld';

const audit = serviceById('automation-opportunity-audit');
const sprint = serviceById('workflow-implementation-sprint');
const systemBuild = serviceById('system-agent-build');
const ops = serviceById('ai-ops-partner');
const homeDescription = staticPages.find((page) => page.path === '/')!.description;

const isProd = import.meta.env.PROD;
const studies = (await getCollection('case-studies'))
  .filter((e) => !(isProd && e.data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const feature = studies.find((e) => e.data.featured) ?? studies[0];
const rest = studies.filter((e) => e.id !== feature?.id).slice(0, 2);

const ladder = [
  { name: audit.name, desc: "We map where your time and money are leaking, and hand you a costed plan. Fee credited against any project you go on to do.", amt: formatGBP(audit.priceFrom), unit: 'from' },
  { name: sprint.name, desc: '1–3 automations live in roughly two weeks.', amt: formatGBP(sprint.priceFrom), unit: 'from' },
  { name: systemBuild.name, desc: 'A custom system or AI agent, built to last.', amt: formatGBP(systemBuild.priceFrom), unit: 'from' },
  { name: ops.name, desc: 'We run it, watch it, and keep automating. Cancel anytime.', amt: formatGBP(ops.priceFrom), unit: 'from', per: '/mo' },
];

const caps = [
  { name: 'Workflow automation', desc: 'Repetitive admin across your existing tools, connected into one reliable flow.' },
  { name: 'Custom systems & portals', desc: 'Software built around how your team works, rather than forcing you into an off-the-shelf template.' },
  { name: 'AI agents', desc: 'Software that reads, drafts, and acts while a person stays in control of every important decision.' },
  { name: 'AI Ops partnership', desc: 'We stay on, keep your systems running, and automate the next job. Cancel anytime.' },
];
---

<BaseLayout
  title="AI & automation for UK small businesses"
  description={homeDescription}
  schema={[serviceCatalogNode()]}
>
  <!-- ─────────────── Hero ─────────────── -->
  <section class="hero hatch">
    <div class="hero__glow" aria-hidden="true">
      <div class="hero__orb hero__orb--a" data-px="34"></div>
      <div class="hero__orb hero__orb--b" data-px="-22"></div>
    </div>
    <div class="hero__inner">
      <p class="eyebrow eyebrow--live hero__eyebrow">AI &amp; automation consultancy · Bradford → UK-wide</p>
      <h1 class="hero__headline">Your admin, automated into <span class="spectral-text">oblivion</span>.</h1>
      <p class="hero__reveal">We make small businesses run like magic.</p>
      <p class="hero__body">
        Automancer builds the software and AI agents that handle the repetitive, error-prone admin
        your team shouldn't be doing by hand. Real systems, published prices, and a human who answers.
      </p>
      <p class="hero__typed">
        <span class="sr-only">It's not magic. It's very good engineering.</span>
        <span class="prompt" aria-hidden="true">&gt;_ </span><span data-typed aria-hidden="true">It's not magic. It's very good engineering.</span><span class="hero__caret" aria-hidden="true"></span>
      </p>
      <div class="hero__ctas">
        <a href="/contact/" class="btn"><span>Book an Automation Audit — from {formatGBP(audit.priceFrom)}</span></a>
        <a href="/work/" class="btn btn--ghost"><span>See the work</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
    <div class="hero__cue" aria-hidden="true"></div>
  </section>

  <!-- ─────────────── Meta-story / proof ─────────────── -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="section-head__top">
          <p class="eyebrow">The proof is the business you're looking at</p>
          <span class="section-head__log">// proof.log — live</span>
        </div>
        <h2>This whole company is run by AI. On purpose.</h2>
        <p>
          Our own finance tracking, project management, website, and field notes run on AI agents.
          Waseem makes every decision and takes every call. The agents handle the routine work;
          the judgement stays human.
        </p>
      </div>

      <div class="proof-grid reveal-stagger">
        {[
          { n: '01', tag: 'finance', h: 'Monitored, not automated', p: 'Agents monitor software spend and draft invoices. Waseem approves and sends them. Bookkeeping stays manual.' },
          { n: '02', tag: 'delivery', h: 'Tracked end to end', p: 'Agents track every project and check each release before Waseem signs it off for a client.' },
          { n: '03', tag: 'content', h: 'This site & blog', p: "Written, built, and maintained by the same agents we put to work in your business." },
          { n: '04', tag: 'control', h: 'One human in the loop', p: 'Every decision and every call goes through Waseem. No call centre and no ticket queue.' },
        ].map((c) => (
          <div class="proof-cell" data-spot>
            <span class="ghost-num" aria-hidden="true">{c.n}</span>
            <span class="proof-cell__n">{c.tag}</span>
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </div>
        ))}
      </div>

      <blockquote class="pullquote reveal" style="margin-top: clamp(3rem, 6vw, 5rem);">
        We build your systems using <span class="spectral-text">the same tools we run our own company on</span>.
      </blockquote>
    </div>
  </section>

  <!-- ─────────────── What we do ─────────────── -->
  <section class="section on-paper">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">What we do</p>
          <span class="section-head__log">// capabilities: 4</span>
        </div>
        <h2>We automate the work that's eating your week.</h2>
        <p>
          If someone on your team spends hours copying figures between systems, updating spreadsheets,
          chasing approvals, or answering the same question every day, a computer can do that job for them.
        </p>
      </div>
      <ol class="cap-list reveal">
        {caps.map((c, i) => (
          <li class="cap-row">
            <span class="cap-row__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cap-row__name">{c.name}</span>
            <span class="cap-row__desc">{c.desc}</span>
          </li>
        ))}
      </ol>
      <p style="margin-top: var(--sp-10)">
        <a href="/services/" class="arrow-link">Not sure what to automate first? Start with an Audit <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- ─────────────── Price ladder teaser ─────────────── -->
  <section class="section on-dark hatch">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">Sensible prices, published</p>
          <span class="section-head__log">// no_funnel = true</span>
        </div>
        <h2>Clear starting prices, upfront.</h2>
        <p>
          We publish our starting prices so you know what to expect before you get in touch.
        </p>
      </div>
      <div class="ladder reveal-stagger">
        {ladder.map((r) => (
          <div class="rung">
            <span class="rung__step"></span>
            <div class="rung__main">
              <h3 class="rung__name">{r.name}</h3>
              <p class="rung__desc">{r.desc}</p>
            </div>
            <div class="rung__price">
              <span class="from">{r.unit}</span>
              <span class="amt">{r.amt}</span>{r.per && <span class="unit">{r.per}</span>}
            </div>
          </div>
        ))}
      </div>
      <p style="margin-top: var(--sp-10)">
        <a href="/services/" class="arrow-link">See what's included <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- ─────────────── Selected work ─────────────── -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2>Real businesses. Real systems. Live in production.</h2>
      </div>
      <div class="case-grid case-grid--pair">
        {feature && (
          <a href={`/work/${feature.id}/`} class="case-card case-card--feature" data-spot>
            <span class="case-card__tag">{feature.data.sector}{feature.data.status ? ` · ${feature.data.status}` : ''}</span>
            <h3 class="case-card__title">{feature.data.title}</h3>
            <p class="case-card__blurb">{feature.data.summary ?? feature.data.description}</p>
            <div class="case-card__foot">
              <span class="arrow-link">Read the case study <span class="btn__arrow">→</span></span>
            </div>
          </a>
        )}
        {rest.map((e) => (
          <a href={`/work/${e.id}/`} class="case-card" data-spot>
            <span class="case-card__tag">{e.data.sector}</span>
            <h3 class="case-card__title">{e.data.title}</h3>
            <p class="case-card__blurb">{e.data.summary ?? e.data.description}</p>
            <div class="case-card__foot">
              <span class="arrow-link">Read <span class="btn__arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top: var(--sp-10)">
        <a href="/work/" class="arrow-link">See all our work <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- ─────────────── Agents & developers ─────────────── -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">For agents &amp; developers</p>
        <h2>This site speaks machine, too.</h2>
        <p>
          Every fact here is also available as data: a public, read-only JSON API that needs no
          authentication, Markdown twins of every page, full-text files written for LLMs, and an
          OpenAPI spec of it all.
        </p>
      </div>
      <div class="cta__ctas" style="margin-top: var(--sp-8); justify-content: flex-start">
        <a href="/developers/" class="btn"><span>Developer &amp; agent documentation</span></a>
        <a href="/llms.txt" class="btn btn--ghost"><span>Read llms.txt</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ─────────────── Final CTA ─────────────── -->
  <section class="section on-dark cta hatch">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="cta__head">Tell us what's eating your week.</h2>
      <p class="cta__body">
        Fill in a short form. No calendar gauntlet, no chatbot, no sales sequence. Waseem reads it
        himself and emails you back — and we promise a meeting within one week of first contact.
      </p>
      <div class="cta__ctas">
        <a href="/contact/" class="btn"><span>Start with an Audit — from {formatGBP(audit.priceFrom)}</span></a>
        <a href="/contact/" class="btn btn--ghost"><span>Just ask a question</span><span class="btn__arrow">→</span></a>
      </div>
      <p class="cta__reassure">
        Based in Bradford. Working with businesses in Leeds, Manchester and across the UK, remote-first.
      </p>
    </div>
  </section>
</BaseLayout>
