---
// Human-readable developer & agent documentation — the front door to every
// machine-readable surface this site offers. The endpoint list renders from
// src/data/api.ts, the same registry behind /api/index.json and
// /openapi.json, so the three can never disagree.
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
import { API_ENDPOINTS } from '../data/api';

const url = (path: string) => `${business.url}${path}`;
---

<BaseLayout
  title="Developer & agent docs"
  description="Every machine-readable surface on automancer.uk: a public read-only JSON API that needs no authentication, Markdown twins of every page, feeds and LLM guides."
  pageType="WebPage"
>
  <section class="hero hatch">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__inner">
      <p class="eyebrow eyebrow--live hero__eyebrow">For developers, agents & LLMs</p>
      <h1 class="hero__headline">Everything here is also <span class="spectral-text">data</span>.</h1>
      <p class="hero__body">
        This site publishes its own facts through a small, static JSON API. It is public,
        read-only, and needs no authentication, no API key and no payment. Fetch anything below
        straight from your code, an agent runtime or <code>curl</code>.
      </p>
      <div class="cta__ctas">
        <a href="#endpoints" class="btn"><span>Jump to the endpoints</span></a>
        <a href={url('/openapi.json')} class="btn btn--ghost"><span>OpenAPI 3.1 spec</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section on-paper">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">Ground rules</p>
          <span class="section-head__log">// policy</span>
        </div>
        <h2>Read-only, key-free, static.</h2>
        <ul style="line-height:1.8;">
          <li><strong>No authentication.</strong> No keys, no accounts, no sign-up. Every URL on this page answers <code>200</code> to anyone.</li>
          <li><strong>Read-only.</strong> Only <code>GET</code> exists — there are no write operations anywhere in this API.</li>
          <li><strong>Static files.</strong> Responses are generated at build time and change only at deploy, so cache them freely; there is no rate limit beyond common sense on a shared host.</li>
          <li><strong>Additive stability.</strong> Payload shapes carry a <code>schemaVersion</code>; changes within a version are additive only. What you may actually rely on — the stable paths, operation ids and service ids, what can change without notice, and how a breaking change is announced — is itself published as data at <a class="tlink" href="/api/stability.json">/api/stability.json</a>.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="endpoints" class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">The JSON API</p>
          <span class="section-head__log">// {API_ENDPOINTS.length} endpoints · GET · no auth</span>
        </div>
        <h2>{API_ENDPOINTS.length} endpoints, one discovery document.</h2>
        <p>
          Start at <a class="tlink" href="/api/index.json">/api/index.json</a> — it lists everything
          below and never goes stale. A formal,
          <a class="tlink" href="/openapi.json">OpenAPI 3.1 specification</a> of all {API_ENDPOINTS.length} operations
          (unique <code>operationId</code>s, typed response schemas — suitable for LLM function
          calling) is served at <a class="tlink" href="/openapi.json">/openapi.json</a>.
        </p>
      </div>

      {API_ENDPOINTS.map((endpoint) => (
        <div class="reveal" style="margin-bottom: var(--sp-8);">
          <h3 style="font-size:var(--t-3); margin-bottom:var(--sp-2);">
            <a class="tlink" href={endpoint.path}>{endpoint.path}</a>
          </h3>
          <p style="color:var(--muted); margin-bottom:var(--sp-3);">{endpoint.description}</p>
          <pre tabindex="0" style="background:var(--near, #111); padding:var(--sp-4); overflow-x:auto;"><code style="font-family:'JetBrains Mono', monospace; font-size:0.9em;">curl -s {url(endpoint.path)}</code></pre>
        </div>
      ))}
    </div>
  </section>

  <section class="section on-paper">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__top">
          <p class="eyebrow">Markdown twins</p>
          <span class="section-head__log">// path + ".md"</span>
        </div>
        <h2>Every content page has a Markdown twin.</h2>
        <p>
          Append <code>.md</code> to any content page's path for clean Markdown with YAML front
          matter (<code>Content-Type: text/markdown; charset=utf-8</code>). For example:
          {' '}<a class="tlink" href="/about.md">{url('/about.md')}</a>,
          {' '}<a class="tlink" href="/services.md">{url('/services.md')}</a>,
          {' '}<a class="tlink" href="/field-notes.md">{url('/field-notes.md')}</a>,
          and every article: <code>{url('/work/<slug>.md')}</code>,{' '}
          <code>{url('/field-notes/<slug>.md')}</code>. The bodies are derived from the same
          source as the HTML pages, not retyped. Legal pages
          (<a class="tlink" href="/privacy/">/privacy</a>, <a class="tlink" href="/terms/">/terms</a>)
          deliberately have no twin — fetch their HTML for the authoritative text.
        </p>
      </div>

      <div class="section-head" style="margin-top:var(--sp-10);">
        <div class="section-head__top">
          <p class="eyebrow">Full-text guides & feeds</p>
          <span class="section-head__log">// for humans, agents and crawlers</span>
        </div>
        <h2>The whole site, in one file if you want it.</h2>
        <ul style="line-height:1.9;">
          <li><a class="tlink" href="/llms.txt">/llms.txt</a> — short plain-text guide to the business and this site, written for LLMs and agents.</li>
          <li><a class="tlink" href="/llms-full.txt">/llms-full.txt</a> — the complete site text in one file, each section headed with its canonical URL.</li>
          <li><a class="tlink" href="/work/feed.json">/work/feed.json</a> and <a class="tlink" href="/work/rss.xml">/work/rss.xml</a> — case studies, full content, not excerpts.</li>
          <li><a class="tlink" href="/field-notes/feed.json">/field-notes/feed.json</a> and <a class="tlink" href="/field-notes/rss.xml">/field-notes/rss.xml</a> — field notes, likewise.</li>
          <li><a class="tlink" href="/sitemap-index.xml">/sitemap-index.xml</a> — every emitted page.</li>
        </ul>
      </div>

      <div class="section-head" style="margin-top:var(--sp-10);">
        <div class="section-head__top">
          <p class="eyebrow">Agent manifest</p>
          <span class="section-head__log">// capabilities & permissions</span>
        </div>
        <h2>One manifest describing how to treat this site.</h2>
        <p>
          <a class="tlink" href="/agent.json">/agent.json</a> is a capability manifest: contact
          routes (and their caveats), every endpoint, crawling policy, permitted uses and the
          legal-pages stance. It is also emitted at{' '}
          <code>/.well-known/agent.json</code> for hosts that serve dot-paths. Security-contact
          details live in <a class="tlink" href="/security.txt">/security.txt</a> (RFC 9116).
          Questions a manifest can't answer? Email{' '}
          <a class="tlink" href={`mailto:${business.email}`}>{business.email}</a> — a human reads it.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
