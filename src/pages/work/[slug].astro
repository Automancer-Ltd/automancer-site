---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpectrumGlow from '../../components/SpectrumGlow.astro';
import ArticleContents from '../../components/ArticleContents.astro';
import { getCollection, render } from 'astro:content';
import { fitDescription, fitTitle } from '../../lib/meta';
import { formatGBP, serviceById } from '../../data/business';
import { caseStudyCard, cardAlt, cardPath } from '../../data/share-cards';

const auditFrom = formatGBP(serviceById('automation-opportunity-audit').priceFrom);

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  // Drafts never build into the production site, so they can never appear in
  // the sitemap or be reached by URL; they stay available in dev for review.
  const studies = (await getCollection('case-studies'))
    .filter((e) => !(isProd && e.data.draft))
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
  return studies.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: studies[(i + 1) % studies.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
// Characters in a figure's longest unbroken run ("Computed"; "£300–400" may
// break after its dash). The figure is sized so that run fits the band.
const longestWord = (v: string) => Math.max(...(v.match(/[^\s–-]+[–-]?/g) ?? ['']).map((w) => [...w].length));
// Notes after the sector, in order. The text keeps the '· ' separators the page
// has always carried, so its words (and published page date) do not change.
const notes = [d.anonymised && 'anonymised', d.status].filter((n): n is string => Boolean(n));
---

{/* SERP metadata is length-fitted (see src/lib/meta.ts); the visible
     headline below keeps the frontmatter copy verbatim. */}
<BaseLayout title={fitTitle(d.title)} description={fitDescription(d.description)} image={cardPath('work', entry.id)} imageAlt={cardAlt(caseStudyCard(entry))} markdown={`/work/${entry.id}.md`}>
  <!-- Designed hero -->
  <article>
    <header class="page-hero hatch">
      <SpectrumGlow class="page-hero__glow" px={26} />
      <div class="page-hero__inner case-hero">
        <p class="eyebrow eyebrow--case">
          <span class="case-meta__sector">{d.sector}</span>
          {notes.length > 0 && (
            <span class="case-meta__notes sys">
              <span class="case-meta__lead">·</span> {notes[0]}{notes.slice(1).map((n) => <span class="case-meta__more">· {n}</span>)}
            </span>
          )}
        </p>
        <h1 class="page-hero__title">{d.headline ?? d.title}</h1>
        {d.subhead && <p class="page-hero__sub">{d.subhead}</p>}
        {d.client && (
          <p class="form__micro" style="margin-top: var(--sp-6); max-width: 60ch;">
            <strong style="color:var(--ink)">Client:</strong> {d.client}
          </p>
        )}
      </div>
    </header>

    <!-- Stat band -->
    {d.stats.length > 0 && (
      <section class="section section--tight on-near">
        <div class="wrap">
          <div class="statband reveal-stagger">
            {d.stats.map((s) => (
              <div class="stat">
                <div class="stat__v" style={`--stat-word: ${longestWord(s.v)}`}>{s.v}</div>
                <div class="stat__l">{s.l}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Long-form body -->
    <section class="section on-dark">
      <div class="wrap article-layout">
        <ArticleContents headings={headings} variant="inline" />
        <div class="prose case-prose">
          <Content />
        </div>
        <ArticleContents headings={headings} variant="rail" />
      </div>
    </section>

    <!-- Next + CTA -->
    <section class="section on-near">
      <div class="wrap">
        <div class="rule--spectral" style="margin-bottom: clamp(2.5rem,5vw,4rem)"></div>
        <div style="display:flex; flex-wrap:wrap; gap:var(--sp-8); justify-content:space-between; align-items:flex-end;">
          <div style="max-width: 40ch;">
            <p class="sys" style="margin-bottom: var(--sp-3)">Next case study</p>
            <a href={`/work/${next.id}/`} class="case-card__title tlink" style="display:inline-block">{next.data.headline ?? next.data.title}</a>
          </div>
          <a href="/work/" class="arrow-link">All work <span class="btn__arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="section on-dark cta hatch">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="wrap">
        <h2 class="cta__head">Got a job like this?</h2>
        <p class="cta__body">
          Start with an Audit and we'll show you where automation will save time and money — with
          real numbers and a plain plan. We promise a meeting within one week of first contact.
        </p>
        <div class="cta__ctas">
          <a href="/contact/" class="btn"><span>Book an Audit — from {auditFrom}</span></a>
          <a href="/work/" class="btn btn--ghost"><span>See more work</span><span class="btn__arrow">→</span></a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
