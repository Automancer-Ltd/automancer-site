---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/prose.css';
import '../../styles/stat-band.css';
import '../../styles/case-cards.css';
import SpectrumGlow from '../../components/SpectrumGlow.astro';
import ArticleContents from '../../components/ArticleContents.astro';
import { getCollection, render } from 'astro:content';
import { formatGBP, serviceById } from '../../data/business';
import { contactHref } from '../../data/enquiry';
import { caseStudyCard, cardAlt, cardPath } from '../../data/share-cards';
import { SOURCES_ANCHOR, SOURCES_INTRO, evidenceAnchor, evidenceRows } from '../../data/claims';

const auditFrom = formatGBP(serviceById('automation-opportunity-audit').priceFrom);

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  // Drafts never build into the production site, so they can never appear in
  // the sitemap or be reached by URL; they stay available in dev for review.
  const studies = (await getCollection('case-studies'))
    .filter((e) => !(isProd && e.data.draft))
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
  return studies.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: studies[(i + 1) % studies.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
// Break a figure at spaces so a price range always stays together. The
// longest run also sets how much to scale the figure in a narrow cell.
const figures = d.stats.map((stat) => {
  const parts = stat.v.split(/(\s+)/);
  const longest = Math.max(1, ...parts.map((part) => [...part.trim()].length));
  return { ...stat, parts, longest };
});
// Notes after the sector, in order. The text keeps the '· ' separators the page
// has always carried, so its words (and published page date) do not change.
const notes = [d.anonymised && 'anonymised', d.status].filter((n): n is string => Boolean(n));
// Every figure the truth layer backs, in the band and in the hero, has a line under "Where these
// numbers come from" (t23334); its fragment is named after its first claim, so a link from another
// page (a field note, a case card) keeps landing on it when the band is reordered (t23577).
const sourced = evidenceRows(d);
---

<BaseLayout title={d.title} description={d.description} image={cardPath('work', entry.id)} imageAlt={cardAlt(caseStudyCard(entry))} markdown={`/work/${entry.id}.md`}>
  <article>
    <header class="page-hero page-hero--compact case-opening hatch">
      <SpectrumGlow class="page-hero__glow" px={26} />
      <div class="page-hero__inner case-hero">
        <p class="eyebrow eyebrow--case">
          <span class="case-meta__sector">{d.sector}</span>
          {notes.length > 0 && (
            <span class="case-meta__notes sys">
              <span class="case-meta__lead">·</span> {notes[0]}{notes.slice(1).map((n) => <span class="case-meta__more">· {n}</span>)}
            </span>
          )}
        </p>
        <div class="case-opening__overview">
          <div>
            <h1 class="page-hero__title">{d.headline ?? d.title}</h1>
            {d.subhead && <p class="page-hero__sub">{d.subhead}</p>}
            {d.client && (
              <p class="case-opening__client">
                <strong>Client:</strong> {d.client}
              </p>
            )}
            {sourced.length > 0 && (
              <a class="stat__src case-hero__src" href={`#${SOURCES_ANCHOR}`}>Where these numbers come from<span aria-hidden="true"> ↓</span></a>
            )}
          </div>
          {figures.length > 0 && (
            <ul class="statband case-opening__figures" role="list" aria-label="Case study figures">
              {figures.map((s) => (
                <li class="stat">
                  <div class="stat__v" style={`--stat-word: ${s.longest}`}>{s.parts.map((part) => part.trim() ? <span>{part}</span> : part)}</div>
                  <div class="stat__l">{s.l}</div>
                  {s.claims.length > 0 && (
                    <a class="stat__src" href={`#${evidenceAnchor(s.claims)}`} aria-label={`Source for ${s.v}`}>Source<span aria-hidden="true"> ↓</span></a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </header>

    <!-- Long-form body -->
    <section class="section on-dark">
      <div class="wrap article-layout">
        <ArticleContents headings={headings} variant="inline" />
        <div class="prose case-prose">
          <Content />
        </div>
        <ArticleContents headings={headings} variant="rail" />
      </div>
    </section>

    <!-- Where these numbers come from: the evidence line behind each sourced figure, the same
         lines /api/claims.json gives machines (t23334). -->
    {sourced.length > 0 && (
      <section class="section on-near evidence" id={SOURCES_ANCHOR} aria-labelledby="sources-title">
        <div class="wrap">
          <p class="sys" style="margin-bottom: var(--sp-3)">// sources</p>
          <h2 class="evidence__title" id="sources-title">Where these numbers come from</h2>
          <p class="evidence__intro">{SOURCES_INTRO}</p>
          <ol class="evidence__list">
            {sourced.map((s) => (
              <li class="evidence__item" id={s.anchor}>
                <p class="evidence__fig"><strong>{s.v}</strong> <span>{s.l}</span></p>
                {s.quotes.map((q) => <blockquote class="evidence__quote"><p>“{q}”</p></blockquote>)}
              </li>
            ))}
          </ol>
          <p class="evidence__machine">
            The same lines, as data for agents: <a class="tlink" href="/api/claims.json">/api/claims.json</a>
          </p>
        </div>
      </section>
    )}

    <!-- Next + CTA -->
    <section class="section on-near">
      <div class="wrap">
        <div class="rule--spectral" style="margin-bottom: clamp(2.5rem,5vw,4rem)"></div>
        <div style="display:flex; flex-wrap:wrap; gap:var(--sp-8); justify-content:space-between; align-items:flex-end;">
          <div style="max-width: 40ch;">
            <p class="sys" style="margin-bottom: var(--sp-3)">Next case study</p>
            <a href={`/work/${next.id}/`} class="case-card__title tlink" style="display:inline-block">{next.data.headline ?? next.data.title}</a>
          </div>
          <a href="/work/" class="arrow-link">All work <span class="btn__arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="section on-dark cta hatch">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="wrap">
        <h2 class="cta__head">Got a job like this?</h2>
        <p class="cta__body">
          Start with an Audit and we'll show you where automation will save time and money — with
          real numbers and a plain plan. We promise a meeting within one week of first contact.
        </p>
        <div class="cta__ctas">
          <a href={contactHref('automation-opportunity-audit')} class="btn"><span>Book an Audit — from {auditFrom}</span></a>
          <a href="/work/" class="btn btn--ghost"><span>See more work</span><span class="btn__arrow">→</span></a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
.case-opening .eyebrow--case { margin-block-end: var(--sp-4); }
.case-opening .page-hero__title {
  font-size: clamp(1.75rem, 1.125rem + 3.5vw, 3.25rem);
}
.case-opening .page-hero__sub { line-height: 1.55; }
.case-opening__client {
  max-inline-size: 54ch;
  margin-block-start: var(--sp-3);
  font-size: var(--t--1);
  color: var(--muted);
}
.case-opening__client strong { color: var(--ink); }
.case-opening__figures {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-self: start;
  gap: 0 var(--sp-5);
  max-inline-size: var(--w-text);
  margin-block-start: var(--sp-5);
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}
.case-opening__figures .stat {
  container-type: inline-size;
  display: flex;
  flex-direction: column;
  align-items: start;
  padding: var(--sp-3) 0;
  border-block-start: 1px solid var(--border-strong);
  background: transparent;
}
.case-opening__figures .stat__v {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: min(clamp(1.25rem, 1.13rem + .55vw, 1.625rem), 100cqi / var(--stat-word));
  font-variant-numeric: lining-nums tabular-nums;
  text-wrap: wrap;
}
.case-opening__figures .stat__v span { white-space: nowrap; }
.case-opening__figures .stat__l { margin-block: var(--sp-1) var(--sp-1); }
.case-opening__figures .stat__src {
  margin-block-start: auto;
  min-block-size: 1.75rem;
  align-content: center;
  text-decoration-color: currentColor;
}
.case-opening__figures .stat__src:active { color: var(--white); }

@container (width >= 20rem) {
  .case-opening__figures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media screen {
  @container (width >= 54rem) {
    .case-opening__overview:has(> .case-opening__figures) {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--sp-12);
    }
    .case-opening__figures { margin-block-start: 0; }
  }
}
@media print {
  .case-opening__figures .stat { padding-inline: var(--sp-3); }
}

/* A case study's eyebrow: sector · anonymised · status. On one line where the
   longest (about 48rem) fits; in a narrower column (phones, tablets, enlarged
   text) the notes take a second line under the sector, without a leading dot,
   instead of squeezing into three ragged columns. */
.case-hero { container-type: inline-size; }
.case-meta__notes { margin-inline-start: .5rem; }
.case-meta__more { margin-inline-start: calc(var(--sp-3) + .5rem); }
@container (max-width: 50rem) {
  .eyebrow.eyebrow--case { display: grid; grid-template-columns: 1.8rem minmax(0, 1fr); row-gap: var(--sp-2); }
  .eyebrow--case::before { align-self: center; }
  .case-meta__notes { grid-column: 2; margin-inline-start: 0; }
  .case-meta__lead { display: none; }
  .case-meta__more { margin-inline-start: .5rem; }
}
</style>
