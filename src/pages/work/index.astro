---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/stat-band.css';
import '../../styles/case-cards.css';
import Bead from '../../components/Bead.astro';
import SpectrumGlow from '../../components/SpectrumGlow.astro';
import { getCollection } from 'astro:content';
import { formatGBP, serviceById } from '../../data/business';
import { contactHref } from '../../data/enquiry';
import { SOURCES_ANCHOR, evidenceRows } from '../../data/claims';

const auditFrom = formatGBP(serviceById('automation-opportunity-audit').priceFrom);

const isProd = import.meta.env.PROD;
const studies = (await getCollection('case-studies'))
  .filter((e) => !(isProd && e.data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const feature = studies.find((e) => e.data.featured) ?? studies[0];
const rest = studies.filter((e) => e.id !== feature?.id);
// A card that quotes a study's figures links to the evidence behind them as well as to the study (t23577).
const sourcesHref = (e: (typeof studies)[number]) => (evidenceRows(e.data).length > 0 ? `/work/${e.id}/#${SOURCES_ANCHOR}` : null);
---

<BaseLayout
  title="Work"
  description="Real systems, live in production. Case studies from a care provider, a manufacturer, a diversity & inclusion consultancy and small firms — all real work."
>
  <section class="page-hero hatch">
    <SpectrumGlow class="page-hero__glow" px={26} />
    <div class="page-hero__inner">
      <p class="eyebrow">Selected work</p>
      <h1 class="page-hero__title">Real businesses. Real systems. Live in production.</h1>
      <p class="page-hero__sub">
        Working systems we built for real UK
        businesses — a care provider, a manufacturer, a diversity &amp; inclusion consultancy, a handful
        of small firms who just needed a proper website. Here's what we did and what it changed.
      </p>
    </div>
  </section>

  <section class="section on-near">
    <div class="wrap">
      <div class="honesty reveal" style="margin-bottom: clamp(2.5rem, 5vw, 4rem);">
        <span class="honesty__mark">// honesty note</span>
        <p>
          Every case study here is anonymised at launch, while we get sign-off from each client to
          name them. Every fact, figure and outcome is real and taken from the actual work — we don't
          invent numbers.
        </p>
      </div>

      <div class="case-grid">
        {feature && (
          <article class="case-card case-card--feature" data-spot>
            <span class="case-card__tag">
              {feature.data.status && <Bead class="live-dot" />}
              {feature.data.sector}{feature.data.status ? ` · ${feature.data.status}` : ''}
            </span>
            <h2 class="case-card__title"><a class="case-card__link" href={`/work/${feature.id}/`}>{feature.data.title}</a></h2>
            <p class="case-card__blurb">{feature.data.summary ?? feature.data.description}</p>
            {feature.data.stats.length > 0 && (
              <div class="statband case-card__stats">
                {feature.data.stats.map((s) => (
                  <div class="stat">
                    <div class="stat__v">{s.v}</div>
                    <div class="stat__l">{s.l}</div>
                  </div>
                ))}
              </div>
            )}
            <div class="case-card__foot">
              <span class="case-card__acts">
                <span class="arrow-link">Read the case study <span class="btn__arrow">→</span></span>
                {sourcesHref(feature) && <a class="case-card__src" href={sourcesHref(feature)} aria-label={`Sources for the figures in “${feature.data.title}”`}>Sources</a>}
              </span>
              <span class="case-card__tag">{feature.data.tags.slice(0, 4).join(' · ')}</span>
            </div>
          </article>
        )}
        {rest.map((e) => (
          <article class="case-card" data-spot>
            <span class="case-card__tag">{e.data.sector}{e.data.status ? ` · ${e.data.status}` : ''}</span>
            <h2 class="case-card__title"><a class="case-card__link" href={`/work/${e.id}/`}>{e.data.title}</a></h2>
            <p class="case-card__blurb">{e.data.summary ?? e.data.description}</p>
            {e.data.statline && <p class="case-card__statline">{e.data.statline}</p>}
            <div class="case-card__foot">
              <span class="case-card__acts">
                <span class="arrow-link">Read <span class="btn__arrow">→</span></span>
                {sourcesHref(e) && <a class="case-card__src" href={sourcesHref(e)} aria-label={`Sources for the figures in “${e.data.title}”`}>Sources</a>}
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section on-dark cta hatch">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="cta__head">Your business could be the next one on this page.</h2>
      <p class="cta__body">
        Start with an Audit and we'll show you where automation would pay for itself — with real
        numbers, not promises.
      </p>
      <div class="cta__ctas">
        <a href={contactHref('automation-opportunity-audit')} class="btn"><span>Book an Audit — from {auditFrom}</span></a>
        <a href="/services/" class="btn btn--ghost"><span>See our services</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
