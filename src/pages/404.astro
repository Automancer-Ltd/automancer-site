---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';

const sections = [
  { href: '/services/', label: 'Services & pricing' },
  { href: '/work/', label: 'Work' },
  { href: '/field-notes/', label: 'Field notes' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const agentPaths = [
  { href: '/sitemap-index.xml', label: 'Sitemap' },
  { href: '/llms.txt', label: 'llms.txt' },
  { href: '/llms-full.txt', label: 'llms-full.txt' },
  { href: '/developers/', label: 'Developer documentation' },
];
---

<BaseLayout
  title="Page not found"
  description="This page has vanished — or never existed. Let's get you back to something real."
>
  <div class="recovery">
    <div class="wrap recovery__layout">
      <div class="recovery__intro">
        <h1>Page not found <span>(404)</span></h1>
        <p>The page at this address may have moved or been removed.</p>
        <a class="btn" href="/"><span>Back to home</span></a>
      </div>

      <nav class="recovery__sections" aria-label="Where were you heading?">
        <h2>Where were you heading?</h2>
        <ul>
          {sections.map(({ href, label }) => (
            <li>
              <a href={href}>{label}<span aria-hidden="true">→</span></a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="recovery__details">
        <h2>Still stuck?</h2>
        <p>Email <a class="tlink" href={`mailto:${business.email}`}>{business.email}</a></p>
        <p>Call <a class="tlink" href={`tel:${business.phoneTel}`}>{business.phone}</a> (voicemail)</p>
      </section>

      <nav class="recovery__details" id="agent-recovery" aria-label="For agents &amp; developers">
        <h2>For agents &amp; developers</h2>
        <ul>
          {agentPaths.map(({ href, label }) => <li><a class="tlink" href={href}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .recovery {
    padding-block: clamp(6.5rem, 10vw, 9rem) clamp(3rem, 7vw, 5rem);
    background: radial-gradient(ellipse at 15% 5%, var(--g-950), var(--black) 65%);
  }

  .recovery__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-8) clamp(var(--sp-8), 7vw, var(--sp-24));
  }

  .recovery__intro h1 {
    font: 800 var(--t-display) / 1.04 var(--font-display);
    letter-spacing: -0.04em;
  }

  .recovery__intro h1 span {
    color: var(--muted);
    font: 500 0.36em / 1 var(--font-mono);
    letter-spacing: 0;
    white-space: nowrap;
  }

  .recovery__intro p {
    max-inline-size: 40ch;
    margin-block: var(--sp-4) var(--sp-5);
    color: var(--muted);
    font-size: var(--t-1);
  }

  .recovery__sections h2 {
    margin-block-end: var(--sp-2);
    font-size: var(--t-1);
  }

  .recovery__sections li {
    border-block-end: 1px solid var(--border);
  }

  .recovery__sections li:first-child {
    border-block-start: 1px solid var(--border);
  }

  .recovery__sections a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-block-size: 44px;
    padding: var(--sp-2) var(--sp-3);
    font-weight: 600;
  }

  .recovery__sections a span {
    color: var(--muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .recovery__sections a:hover { background: var(--g-950); }
  }

  .recovery__sections a:active { background: var(--g-900); }

  .recovery__details {
    border-block-start: 1px solid var(--border);
    padding-block-start: var(--sp-4);
  }

  .recovery__details h2 {
    margin-block-end: var(--sp-2);
    font-size: var(--t-0);
  }

  .recovery__details p {
    max-inline-size: 42ch;
    color: var(--muted);
  }

  .recovery__details a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .recovery__details ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
  }

  @media (min-width: 52rem) {
    .recovery__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      row-gap: var(--sp-12);
    }
  }
</style>
