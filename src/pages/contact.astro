---
// Contact page.
//
// Wired to the finalised AUTD lead-intake endpoint (src/config/site.ts).
// NO third-party form processors. src/scripts/contact-form.ts posts application/json to ENDPOINT_URL.
//
// Contract:
//   Body { name, email, company?, message, turnstileToken, website(honeypot) }.
//   200 {ok:true}; every other status carries a MACHINE CODE in `error`.
//   The visitor-facing wording for each code lives in LEAD_ERROR_COPY
//   (src/config/site.ts) — that map is the documentation. Do not list codes
//   here as well; a transcribed contract nothing compares goes stale silently,
//   which is exactly what happened to the list that used to be on this line.
//   Content-Type application/json · no credentials.
//   The endpoint also accepts utmSource?/utmMedium?/utmCampaign?, and this page
//   used to send them. It no longer does — the capture was removed 2026-08-22
//   (AUT-6414) to keep /privacy's claim that our own site code stores nothing
//   in the browser true. The reasoning is in BaseLayout.astro; do not re-add
//   these without reading it.
//   NOTE: the API CORS origin is locked to https://automancer.uk, so live
//   submissions only succeed from production. Local dev/preview will hit a
//   CORS wall and fall through to the mailto fallback (expected).
import BaseLayout from '../layouts/BaseLayout.astro';
import Bead from '../components/Bead.astro';
import SpectrumGlow from '../components/SpectrumGlow.astro';
import { ENDPOINT_URL, TURNSTILE_SITE_KEY } from '../config/site';
import type { EnquiryPageData } from '../scripts/contact-form';
import { business } from '../data/business';
import { AFTER_SEND_STEPS, ENQUIRY_FIELDS, SERVICE_OPTIONS, SERVICE_PARAM, enquiryField } from '../data/enquiry';

const steps = AFTER_SEND_STEPS;
const f = enquiryField;
const emailLink = `mailto:${business.email}`;
// What src/scripts/contact-form.ts needs from the enquiry contract, as data.
const enquiry: EnquiryPageData = {
  email: business.email,
  serviceParam: SERVICE_PARAM,
  fields: ENQUIRY_FIELDS.map(({ id, label }) => ({ id, label })),
  services: SERVICE_OPTIONS.map(({ value, label }) => ({ value, label })),
};
// This page alone may load Turnstile, show its challenge frame and send the
// enquiry to the intake API; every other page's policy refuses all three.
Astro.csp!.insertScriptResource('https://challenges.cloudflare.com');
Astro.csp!.insertDirective('frame-src https://challenges.cloudflare.com');
Astro.csp!.insertDirective(`connect-src ${new URL(ENDPOINT_URL).origin}`);
---

<BaseLayout
  trustedTypes={['turnstile']}
  title="Contact"
  description="Tell us what's eating your week. No calendar gauntlet, no chatbot. Waseem reads it himself, and we promise a meeting within one week of first contact."
>
  <section class="page-hero contact-hero hatch">
    <SpectrumGlow class="page-hero__glow" px={26} />
    <div class="page-hero__inner">
      <div>
        <h1 class="page-hero__title">Tell us what's eating your week.</h1>
        <p class="page-hero__sub">Waseem reads your enquiry himself.</p>
      </div>
      <div class="contact-routes">
        <a class="contact-route" href={emailLink}>
          <strong>Email Waseem</strong>
          <span>{business.email}</span>
        </a>
        <a class="contact-route" href={`tel:${business.phoneTel}`}>
          <strong>Leave a voicemail</strong>
          <span>{business.phone}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section contact-section on-near">
    <div class="wrap">
      <div class="contact-grid">
        <div>
          <div class="section-head enquiry-heading">
            <h2>Send an enquiry</h2>
            <p>
              Tell us a bit about your business and what's driving you mad. You don't need to know
              the solution.
            </p>
          </div>

          <p id="form-unavailable">Please email <a href={emailLink}>{business.email}</a> to get in touch.</p>
          <form id="contact-form" class="form" method="POST" novalidate data-endpoint={ENDPOINT_URL} data-enquiry={JSON.stringify(enquiry)} hidden>
            <!-- Arriving from an offer's button names the offer here,
                 so the visitor sees their choice came with them; "Change" jumps to it. -->
            <p id="service-carried" class="service-carried" data-page-words="skip" hidden>
              <span class="service-carried__label">Asking about</span>
              <strong data-service-name></strong>
              <a href="#service-pick" class="service-carried__change">Change</a>
            </p>
            <div class="contact-fields">
              <div class="field">
                <label for="name">{f('name').label}</label>
                <input type="text" id="name" name="name" required autocomplete="name" maxlength={f('name').maxLength} />
              </div>
              <div class="field">
                <label for="email">{f('email').label}</label>
                <input type="email" id="email" name="email" required autocomplete="email" maxlength={f('email').maxLength} />
              </div>
            </div>
            <div class="field">
              <label for="time-sink">{f('time_sink').label}</label>
              <textarea id="time-sink" name="time_sink" required maxlength={f('time_sink').maxLength}
                placeholder={f('time_sink').example}></textarea>
            </div>
            <details id="optional-details" class="form-details">
              <summary>Add optional details <span id="optional-service" class="form-details__service"></span></summary>
              <div class="form-details__fields">
                <fieldset id="service-pick" class="service-pick" tabindex="-1">
                  <legend>{f('service').label} <span class="opt">(optional)</span></legend>
                  <div class="service-pick__options">
                    {SERVICE_OPTIONS.map((o) => (
                      <label class="service-option">
                        <input type="radio" name="service" value={o.value} />
                        <span class="service-option__name">{o.label}</span>
                        {o.price && <span class="service-option__price">{o.price}</span>}
                      </label>
                    ))}
                  </div>
                </fieldset>
                <div class="field">
                  <label for="company">{f('company').label} <span class="opt">(optional)</span></label>
                  <input type="text" id="company" name="company" autocomplete="organization" maxlength={f('company').maxLength} />
                </div>
                <div class="field">
                  <label for="team-size">{f('team_size').label} <span class="opt">(optional)</span></label>
                  <input type="text" id="team-size" name="team_size" autocomplete="off" maxlength={f('team_size').maxLength} placeholder={f('team_size').example} />
                </div>
                <div class="field">
                  <label for="extra">{f('extra').label} <span class="opt">(optional)</span></label>
                  <textarea id="extra" name="extra" maxlength={f('extra').maxLength}></textarea>
                </div>
              </div>
            </details>

            <!-- Honeypot: must submit empty. Off-screen + aria-hidden + no autofill/tab. -->
            <div aria-hidden="true" style="position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden;">
              <label for="website">Leave this field blank</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="field form-security">
              <span class="sys" style="color:var(--muted)">Security check</span>
              <div class="cf-turnstile turnstile-slot" data-sitekey={TURNSTILE_SITE_KEY} data-theme="dark" data-error-callback="onTurnstileError"></div>
            </div>

            <p id="form-error" class="form__micro" style="display:none; color:var(--spec-1)" role="alert"></p>

            <!-- Disabled until the script below takes over: with no action, a no-JS submit
                 would POST the enquiry to GitHub Pages and lose it. -->
            <button type="submit" class="btn btn--full" disabled><span>Send it to Waseem</span></button>

            <div id="form-recovery" class="form-recovery" hidden>
              <p>Send your enquiry by email to <a id="email-enquiry" href={emailLink}>{business.email}</a>.</p>
              <button id="copy-enquiry" type="button" class="btn btn--ghost"><span>Copy enquiry</span></button>
              <p id="copy-enquiry-status" role="status"></p>
              <div id="enquiry-draft-field" class="field" hidden>
                <label for="enquiry-draft">Enquiry draft</label>
                <textarea id="enquiry-draft" rows="4" readonly></textarea>
              </div>
            </div>

            <p class="form__micro">
              No spam, no sales sequence, no sharing your details. Just a human reading what you sent.
            </p>
          </form>

          <div id="form-confirm" class="form-confirm" style="display:none" role="status" aria-live="polite">
            <p class="sys sys--spectral" style="margin-bottom: var(--sp-4)"><Bead />received</p>
            <h2 tabindex="-1">Thanks — that's landed with Waseem.</h2>
            <p>
              He reads these himself, and you'll get a personal reply. We promise a meeting within one
              week of first contact. No chatbot, no queue.
            </p>
          </div>
        </div>
        <div>
          <div class="promise reveal">
            <p class="sys sys--spectral" style="margin-bottom: var(--sp-4)"><Bead />the one-week promise</p>
            <p class="promise__big">1 week<span class="u">to a meeting, from first contact</span></p>
            <p>
              Not a number in the diary three weeks out, not an automated "someone will be in touch" —
              an actual conversation with an actual human, within seven days. Agents do the heavy lifting
              behind the scenes, but a human makes every decision and takes every call.
            </p>
          </div>
          <p class="form__micro" style="margin-top: var(--sp-6);">
            Based in Bradford · Leeds · Manchester · UK-wide, remote-first.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="section on-dark hatch">
    <div class="wrap wrap--text">
      <div class="section-head">
        <p class="eyebrow">After you hit send</p>
        <h2>What happens next.</h2>
      </div>
      <div class="steps-num">
        {steps.map((s) => (
          <div class="step-num">
            <span class="step-num__n"></span>
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="form__micro" style="margin-top: var(--sp-8)">
        That's it. No funnel, no pressure, no "book a slot with a bot". Just tell us what's wrong and
        let a human sort it.
      </p>
    </div>
  </section>

  <script>
    import '../scripts/contact-form';
  </script>
</BaseLayout>

<style is:global>
/* ─────────────────────── Contact / form ─────────────────────── */
/* Align the introduction and the direct routes with the form and its promise. */
.contact-hero .page-hero__inner, .contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  column-gap: clamp(2.5rem, 6vw, 5rem);
}
.page-hero.contact-hero { padding-block: clamp(6.5rem, 9vw, 8rem) var(--sp-8); }
.contact-hero .page-hero__inner { align-items: end; row-gap: var(--sp-5); }
.contact-hero .page-hero__title { font-size: var(--t-4); margin-block-start: 0; }
.contact-hero .page-hero__sub { font-size: var(--t-0); margin-top: var(--sp-4); }
.contact-routes {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}
.contact-route {
  flex: 1 1 auto;
  min-inline-size: 0;
  display: grid;
  align-content: center;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-4);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  background: var(--g-975);
  color: var(--ink);
  line-height: 1.3;
  overflow-wrap: anywhere;
}
.contact-route span { color: var(--muted); font-size: 0.9rem; text-decoration: underline; text-underline-offset: 0.18em; }
.contact-route:active { background: var(--g-900); }
.contact-route:focus-visible { outline: 2px solid var(--white); outline-offset: 2px; }
@media (hover: hover) and (pointer: fine) {
  .contact-route:hover { border-color: var(--g-500); background: var(--g-950); }
  .contact-route:hover span { color: var(--ink); }
}

.section.contact-section { padding-block-start: clamp(2rem, 4vw, 3.5rem); }
.contact-grid { row-gap: var(--sp-10); align-items: start; }
.section-head.enquiry-heading { margin-block-end: var(--sp-4); }
.section-head.enquiry-heading h2 { font-size: var(--t-3); }
.section-head.enquiry-heading p:not(.eyebrow) { margin-block-start: var(--sp-3); font-size: var(--t-0); }
@media (max-width: 860px) {
  .contact-hero .page-hero__inner, .contact-grid { grid-template-columns: minmax(0, 1fr); }
  .page-hero.contact-hero { padding-block: var(--sp-24) var(--sp-5); }
  .contact-hero .page-hero__inner { row-gap: var(--sp-3); }
  .contact-hero .page-hero__sub { margin-block-start: var(--sp-3); }
  .contact-route { padding-inline: var(--sp-2); font-size: 0.9375rem; }
  .contact-route span { font-size: 0.875rem; }
  .section.contact-section { padding-block-start: var(--sp-6); }
}

.promise { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.5rem, 3vw, 2.25rem);
  background: linear-gradient(180deg, var(--near), var(--g-975)); }
.promise__big { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem);
  letter-spacing: -0.04em; line-height: 1; }
.promise__big .u { font-family: var(--font-mono); font-size: 0.9rem; font-weight: 500; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--muted); display: block; margin-top: var(--sp-3); }
.promise p { color: var(--muted); margin-top: var(--sp-5); }

.form:not([hidden]) { display: flex; flex-direction: column; gap: var(--sp-4); }
.contact-fields {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
  gap: var(--sp-4);
}
.field:not([hidden]) { display: flex; flex-direction: column; gap: var(--sp-2); }
.field > label { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--muted); }
.field .opt { color: var(--faint); text-transform: none; letter-spacing: 0; }
.field input, .field textarea, .field select {
  width: 100%; background: var(--g-975); border: 1px solid var(--border-strong); border-radius: var(--radius);
  padding: 0.65em 1em; font-size: var(--t-0); color: var(--ink);
  transition: border-color var(--dur-1), background var(--dur-1), box-shadow var(--dur-1);
}
.field textarea { min-height: 8rem; resize: vertical; }
.field input::placeholder, .field textarea::placeholder { color: var(--faint); }
.field input:focus, .field textarea:focus, .field select:focus {
  outline: none; border-color: var(--g-400); background: var(--g-950);
  box-shadow: 0 0 0 3px rgba(255,255,255,0.06);
}
/* Keyboard focus must pass focus-appearance: 2px white ring, ≥3:1 against the
   field and its surroundings (pointer focus keeps the quieter border change). */
.field input:focus-visible, .field textarea:focus-visible, .field select:focus-visible {
  outline: 2px solid var(--white); outline-offset: 2px; border-color: var(--white);
}
.field--hero label { font-size: 0.8rem; color: var(--ink); }
.form-security:has(.turnstile-slot:empty) { display: none; }
/* The standard widget is 300px wide. On narrow phones, borrow evenly from the page gutters. */
.turnstile-slot {
  min-block-size: 65px;
  inline-size: max(100%, 300px);
  margin-inline: min(0px, 50% - 150px);
}

.form-details { border-block: 1px solid var(--border-strong); }
.form-details summary { padding-block: 0.7rem; color: var(--ink); cursor: pointer; }
.form-details summary:active { background: var(--g-950); }
.form-details__fields { display: grid; gap: var(--sp-6); padding-block: var(--sp-3) var(--sp-6); }
.form-details__service { color: var(--muted); margin-inline-start: 0.4em; }
.form-details[open] .form-details__service, .form-details__service:empty { display: none; }

.service-pick { border: 0; margin: 0; padding: 0; min-width: 0; scroll-margin-top: 6rem; }
.service-pick > legend { padding: 0; margin-bottom: var(--sp-3); font-family: var(--font-mono); font-size: 0.72rem;
  font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
.service-pick:focus { outline: none; }
.service-pick .opt { color: var(--faint); text-transform: none; letter-spacing: 0; }
/* At most two across (each at least 34% of the row), one across below ~152px each. */
.service-pick__options { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, max(9.5rem, 34%)), 1fr)); gap: var(--sp-2); }
.service-option { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 0.3rem;
  min-height: 3.5rem; padding: 0.75rem 2.25rem 0.75rem 1rem; border: 1px solid var(--border-strong);
  border-radius: var(--radius); background: var(--g-975); color: var(--ink); cursor: pointer;
  transition: border-color var(--dur-1), background-color var(--dur-1), color var(--dur-1); }
.service-option:last-child { grid-column: 1 / -1; }
.service-option input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
.service-option::after { content: ""; position: absolute; top: 0.85rem; right: 0.85rem; width: 0.8rem; height: 0.8rem;
  border: 1px solid var(--g-500); border-radius: 50%; transition: border-color var(--dur-1), box-shadow var(--dur-1); }
.service-option__name { font-size: 0.95rem; font-weight: 500; line-height: 1.25; overflow-wrap: break-word; }
.service-option__price { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--muted); }
.service-option:hover { border-color: var(--g-500); background: var(--g-950); }
.service-option:has(input:checked) { background: var(--white); border-color: var(--white); color: var(--black); }
.service-option:has(input:checked) .service-option__price { color: var(--g-600); }
.service-option:has(input:checked)::after { border-color: var(--black); box-shadow: inset 0 0 0 3px var(--white), inset 0 0 0 8px var(--black); }
.service-option:has(input:focus-visible) { outline: 2px solid var(--white); outline-offset: 3px; }
@media (max-width: 480px) {
  .service-pick__options { grid-template-columns: minmax(0, 1fr); }
  .service-option { flex-flow: row wrap; justify-content: space-between; align-items: center;
    gap: 0.25rem 0.75rem; min-height: 2.75rem; padding: 0.6rem 0.8rem 0.6rem 2.25rem; }
  .service-option::after { inset-inline: 0.8rem auto; inset-block-start: 50%; translate: 0 -50%; }
}

.service-carried:not([hidden]) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35em 0.6em;
  padding: 0.6rem 0.9rem; border: 1px solid var(--border-strong); border-left: 3px solid var(--white);
  border-radius: var(--radius); background: var(--g-975); font-size: 0.95rem; color: var(--ink); }
.service-carried__label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--muted); }
.service-carried strong { font-weight: 600; }
.service-carried__change { margin-left: auto; font-size: 0.9rem; text-decoration: underline; text-underline-offset: 0.15em; }

.form-recovery:not([hidden]) {
  display: grid; justify-items: start; gap: var(--sp-3);
  grid-template-columns: minmax(0, 1fr);
  padding: var(--sp-5); border: 1px solid var(--border-strong); border-radius: var(--radius);
  background: var(--g-975);
}
.form-recovery .field { width: 100%; }
.form-recovery [role="status"]:empty { margin: calc(-1 * var(--sp-3)) 0 0; }
#form-unavailable a, .form-recovery a { text-decoration: underline; text-underline-offset: 0.15em; }
.form-confirm { border: 1px solid var(--border-strong); border-radius: var(--radius-lg); padding: clamp(2rem, 4vw, 3rem);
  background: var(--g-975); }
.form-confirm h2 { font-size: var(--t-2); }
.form-confirm p { color: var(--muted); margin-top: var(--sp-4); }

.steps-num { counter-reset: st; display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--border); }
.step-num { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-5); padding-block: var(--sp-6);
  border-bottom: 1px solid var(--border); }
.step-num__n { font-family: var(--font-mono); font-size: 0.8rem; color: var(--faint); }
.step-num__n::before { counter-increment: st; content: "0" counter(st); }
.step-num h3 { font-size: var(--t-1); }
.step-num p { color: var(--muted); margin-top: var(--sp-2); max-width: 56ch; }
</style>
