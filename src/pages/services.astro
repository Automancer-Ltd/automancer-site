---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatGBP, serviceById } from '../data/business';
import { serviceCatalogNode } from '../data/jsonld';
import { staticPages } from '../data/site-content';

const audit = serviceById('automation-opportunity-audit');
const sprint = serviceById('workflow-implementation-sprint');
const systemBuild = serviceById('system-agent-build');
const ops = serviceById('ai-ops-partner');
const servicesDescription = staticPages.find((page) => page.path === '/services/')!.description;

const overview = [
  { name: audit.name, from: formatGBP(audit.priceFrom), what: 'A costed map of what to automate first. Fee credited against any follow-on project.' },
  { name: sprint.name, from: formatGBP(sprint.priceFrom), what: '1–3 automations live in ~2 weeks.' },
  { name: systemBuild.name, from: formatGBP(systemBuild.priceFrom), what: 'A custom system or AI agent, built properly.' },
  { name: ops.name, from: `${formatGBP(ops.priceFrom)}/mo`, what: 'We run it, watch it, keep automating. Cancel anytime.' },
];

const offers = [
  {
    step: 'Rung 01 · start here',
    name: audit.name,
    amt: formatGBP(audit.priceFrom),
    note: 'from · credited in full against any project you go on to do',
    one: 'We find where your time and money are leaking and hand you a costed plan to fix it.',
    who: "You know time is being lost to double-entry, spreadsheet updates, and chasing tasks, but you want to know what is worth fixing first. Start here.",
    includes: audit.includes,
    catch: `If you go on to book a Sprint or a Build with us, the audit fee is deducted in full from the project price. Otherwise, you keep a clear plan for ${formatGBP(audit.priceFrom)}.`,
    cta: 'Book an Audit',
  },
  {
    step: 'Rung 02 · act fast',
    name: sprint.name,
    amt: formatGBP(sprint.priceFrom),
    note: 'from',
    one: '1–3 automations, live and working, in roughly two weeks.',
    who: 'You already know which repetitive admin jobs are slowing your team down and you want them automated quickly.',
    includes: sprint.includes,
    catch: 'Typical jobs: turning enquiries into quotes, preparing invoices and reconciliations, syncing data between two systems, routing approvals, and generating weekly reports automatically.',
    cta: 'Start a Sprint',
  },
  {
    step: 'Rung 03 · build it right',
    name: systemBuild.name,
    amt: formatGBP(systemBuild.priceFrom),
    note: 'from',
    one: 'A custom system or AI agent built around how your business runs.',
    who: 'You have outgrown spreadsheets or off-the-shelf tools that do not fit your process. You need a customer portal, an internal operations system, or an AI agent with human sign-off.',
    includes: systemBuild.includes,
    catch: 'Recent builds: a customer trade portal that replaced phone-and-memory ordering, a care provider’s operations platform with 294 carer records and 588 scheduled supervisions, and a self-service AI product that runs a £300–400 consultant review for £10–80.',
    cta: 'Scope a Build',
  },
  {
    step: 'Rung 04 · stay live',
    name: ops.name,
    amt: formatGBP(ops.priceFrom),
    per: '/mo',
    note: 'from · cancel anytime',
    one: 'We stay on, keep your systems running, and automate the next bottleneck.',
    who: 'You have live automation and want it monitored, maintained, and steadily improved without hiring an in-house engineer.',
    includes: ops.includes,
    catch: 'Because our own monitoring and operations run on AI agents, we can watch and maintain your systems at a low monthly cost.',
    cta: 'Become a Partner',
  },
];

const faqs = [
  { q: 'Is it really this cheap?', a: 'Yes. We run our own finance tracking, project management, and website on AI agents, which keeps our overheads low. The prices on this page are real starting prices for published work.' },
  { q: 'What if it breaks?', a: 'Every system we ship is monitored, backed up, and tested. On an AI Ops Partner plan, we watch it day to day and fix issues as they arise. When you need help, you speak directly with Waseem rather than a ticket queue.' },
  { q: 'Do I need to understand AI?', a: 'No. You know your business and where time is being lost; we handle the software and explain every step in plain English.' },
  { q: 'Will a human actually answer?', a: 'Always. Agents do the background work, while Waseem makes every decision and takes every call. When you get in touch, he reads it himself and replies personally. We promise a meeting within one week of first contact.' },
  { q: 'Where are you, and do you work remotely?', a: 'We are based in Bradford and work with businesses in Leeds, Manchester, and across the UK. Most of our work runs remotely.' },
  { q: 'What if I just want a website?', a: 'We build those too: fast, compliant websites with no monthly platform fees.' },
];
---

<BaseLayout
  title="Services & pricing"
  description={servicesDescription}
  schema={[serviceCatalogNode()]}
>
  <!-- Hero -->
  <section class="page-hero hatch">
    <div class="page-hero__glow" aria-hidden="true" data-px="26"></div>
    <div class="page-hero__inner">
      <p class="eyebrow">Services &amp; pricing</p>
      <h1 class="page-hero__title">Four ways in. All of them start with a price you can actually see.</h1>
      <p class="page-hero__sub">
        We publish our starting prices so you can check whether we fit your budget before booking a call.
        Here is what we do, who each service is for, and what it costs to start.
      </p>
      <p class="form__micro" style="margin-top: var(--sp-6); max-width: 60ch;">
        Every price below is a <em>from</em> price for real work. Where your project is larger, we
        tell you the full price upfront before we start.
      </p>
    </div>
  </section>

  <!-- Ladder overview -->
  <section class="section section--tight on-near">
    <div class="wrap">
      <div class="section-head" style="max-width: 46ch;">
        <h2>Think of these as rungs.</h2>
        <p>
          Most clients start with an Audit, move to a Sprint or a Build, and keep us on as their AI
          Ops Partner. You can start at any rung.
        </p>
      </div>
      <div class="overview-list reveal">
        {overview.map((r) => (
          <div class="overview-row">
            <div class="overview-row__head">
              <span class="overview-row__name">{r.name}</span>
              <span class="overview-row__price"><span class="from">from</span>{r.from}</span>
            </div>
            <p class="overview-row__what">{r.what}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Offer detail blocks -->
  {offers.map((o, i) => (
    <section class={`section ${i % 2 === 0 ? 'on-paper' : 'on-dark hatch'}`} id={`offer-${i + 1}`}>
      <div class="wrap">
        <div class={`offer${i % 2 === 1 ? ' offer--reverse' : ''}`}>
          <div class="offer__lede reveal">
            <p class="offer__stepline">
              <span class="offer__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="offer__step">{o.step}</span>
            </p>
            <h2 class="offer__name">{o.name}</h2>
            <p class="offer__price">
              <span class="offer__amt">{o.amt}</span>{o.per && <span class="offer__amt" style="font-size:var(--t-1)">{o.per}</span>}
              <span class="note">{o.note}</span>
            </p>
            <p class="offer__one">{o.one}</p>
            <p class="offer__who">{o.who}</p>
            <p style="margin-top: var(--sp-8)">
              <a href="/contact/" class="btn btn--primary"><span>{o.cta}</span><span class="btn__arrow">→</span></a>
            </p>
          </div>
          <div class="offer__includes reveal">
            <h3>What's included</h3>
            <ul class="ticks">
              {o.includes.map((it) => <li>{it}</li>)}
            </ul>
            <p class="offer__catch">{o.catch}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- FAQs -->
  <section class="section on-near">
    <div class="wrap wrap--text">
      <div class="section-head">
        <p class="eyebrow">Straight answers</p>
        <h2>The questions everyone asks.</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section on-dark cta hatch">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="cta__head">Start where it makes sense for you.</h2>
      <p class="cta__body">
        Not sure which service fits? Start with an Audit to get a costed plan, and we deduct the
        audit fee in full if you go ahead with a project.
      </p>
      <div class="cta__ctas">
        <a href="/contact/" class="btn"><span>Book an Audit — from {formatGBP(audit.priceFrom)}</span></a>
        <a href="/contact/" class="btn btn--ghost"><span>Ask us which offer fits</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
