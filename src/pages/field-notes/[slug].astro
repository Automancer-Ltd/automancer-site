---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/note-rows.css';
import '../../styles/prose.css';
import Bead from '../../components/Bead.astro';
import SpectrumGlow from '../../components/SpectrumGlow.astro';
import JsonLd from '../../components/JsonLd.astro';
import ArticleContents from '../../components/ArticleContents.astro';
import { articleNode } from '../../data/jsonld';
import { getCollection, render } from 'astro:content';
import { fitDescription, fitTitle } from '../../lib/meta';
import { formatGBP, serviceById } from '../../data/business';
import { cardAlt, cardPath, fieldNoteCard } from '../../data/share-cards';
import { getNotes } from '../../data/site-content';
import { relatedNotes } from '../../data/related-notes';

const auditFrom = formatGBP(serviceById('automation-opportunity-audit').priceFrom);

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  // Drafts never build into the production site (no unlinked placeholder
  // pages ship); they remain reachable in dev for review.
  const posts = (await getCollection('field-notes'))
    .filter((e) => !(isProd && e.data.draft));
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const card = cardPath('field-notes', entry.id);

const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const short = (dt: Date) =>
  dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

// The notes this one offers next: same subject first (src/data/related-notes.ts).
const asRelatable = (n: typeof entry) => ({ id: n.id, topic: n.data.category ?? n.data.sector, tags: n.data.tags, date: n.data.date, note: n });
const published = (await getNotes()).map(asRelatable);
const next = relatedNotes(asRelatable(entry), published).map((r) => r.note);
---

{/* SERP metadata is length-fitted (see src/lib/meta.ts); the visible
     article title below keeps the frontmatter copy verbatim. */}
<BaseLayout title={fitTitle(d.title)} description={fitDescription(d.description)} ogType="article" image={card} imageAlt={cardAlt(fieldNoteCard(entry))} markdown={`/field-notes/${entry.id}.md`}>
  <Fragment slot="head">
    <JsonLd
      nodes={[articleNode({ path: Astro.url.pathname, title: d.title, description: d.description, date: d.date, author: d.author, body: entry.body, image: card })]}
    />
  </Fragment>

  <article>
    <header class="page-hero page-hero--article hatch">
      <SpectrumGlow class="page-hero__glow" px={26} />
      <div class="page-hero__inner">
        <div class="article-head" style="margin-inline:0">
          <a href="/field-notes/" class="article-back"><span class="btn__arrow">←</span> Field notes</a>
          <p class="article-meta">
            <span>{fmt(d.date)}</span>
            <span class="sep">·</span>
            <span>{d.category ?? d.sector}</span>
            <span class="sep">·</span>
            <span>{d.author}</span>
            {d.draft && <><span class="sep">·</span><span class="sys--spectral"><Bead />draft</span></>}
          </p>
          <h1 class="article-title">{d.title}</h1>
          <p class="page-hero__sub" style="margin-top:0">{d.description}</p>
          <div class="rule--spectral" style="margin-top: clamp(2rem, 4vw, 2.5rem)"></div>
        </div>
      </div>
    </header>

    <section class="section on-dark article-body">
      <div class="wrap article-layout">
        <ArticleContents headings={headings} variant="inline" />
        <div class="prose" style="margin-inline:0">
          <Content />
        </div>
        <ArticleContents headings={headings} variant="rail" />

        <footer class="article-head article-foot" style="margin-inline:0; margin-top: clamp(3rem,6vw,5rem)">
          <div class="rule--spectral" style="margin-bottom: var(--sp-8)"></div>
          <p class="form__micro">
            Written by an Automancer agent · reviewed and published by {d.author}. Agents do the work;
            a human makes the call.
          </p>
        </footer>

        {/* Navigation, not the note's words: it changes no page date (data-page-words).
            The "All field notes" link stays outside it, after the byline, as it always was. */}
        <nav class="read-next" aria-label="Keep reading" data-read-next data-page-words="skip">
          <h2 class="read-next__title">Keep reading</h2>
          <div class="note-list">
            {next.map((n) => (
              <a href={`/field-notes/${n.id}/`} class="note-row note-row--compact">
                <div class="note-row__head">
                  <h3 class="note-row__title">{n.data.title}</h3>
                  <span class="note-row__meta">{short(n.data.date)} · {n.data.category ?? n.data.sector}</span>
                </div>
                <p class="note-row__sum">{n.data.summary ?? n.data.description}</p>
                <span class="note-row__line" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        </nav>
        <a href="/field-notes/" class="arrow-link read-next__all">All field notes <span class="btn__arrow">→</span></a>
      </div>
    </section>

    <section class="section on-near cta">
      <div class="wrap">
        <h2 class="cta__head" style="font-size:var(--t-4)">Sounds like your Tuesday?</h2>
        <p class="cta__body">Tell us what's eating your week. Waseem reads every enquiry himself.</p>
        <div class="cta__ctas">
          <a href="/contact/" class="btn"><span>Book an Audit — from {auditFrom}</span></a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
/* Article meta header */
.article-head { max-width: var(--w-read); margin-inline: auto; }
.article-back { display: inline-flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-6);
  font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--faint); transition: color var(--dur-1); }
.article-back:hover { color: var(--white); }
.article-back .btn__arrow { transition: transform var(--dur-2) var(--ease-out-expo); }
.article-back:hover .btn__arrow { transform: translateX(-4px); }

/* Capped below the page-hero size: at --t-display a laptop's first screen
   (1280x800) was all title, and the note's opening line sat below the fold.
   The cap binds from about 1,000px wide; phones keep --t-display. */
.article-title { font-size: min(var(--t-display), 3.25rem); line-height: 1.04; letter-spacing: -0.04em;
  text-wrap: balance; margin-bottom: var(--sp-6); }

/* ─────────────────── Article contents (field notes, case studies) ───────────────────
   The header hands straight on to the text (its full padding left ~120px of
   black on a phone, 205px on desktop). Wide screens keep the note's contents
   beside the text; narrower ones offer them closed above the first paragraph
   (src/components/ArticleContents.astro). */
.page-hero.page-hero--article { padding-top: clamp(7.5rem, 10vw, 8.5rem); padding-bottom: clamp(1.25rem, 3vw, 2.5rem); }
.section.article-body { padding-top: clamp(1.5rem, 4vw, 3.5rem); }

/* "Keep reading" at the end of a field note: the next notes on its subject
   (src/data/related-notes.ts), in the index's row style at the reading measure. */
.read-next { margin-top: clamp(3.5rem, 7vw, 5.5rem); }
.read-next__title { font-size: var(--t-3); letter-spacing: -0.03em; margin-bottom: var(--sp-6); }
.note-row--compact { padding-block: clamp(1.25rem, 2.5vw, 1.75rem); }
.note-row--compact .note-row__title { font-size: var(--t-1); line-height: 1.3; max-width: 30ch; text-wrap: balance; }
.note-row--compact .note-row__sum { margin-top: var(--sp-2); font-size: .95rem; }
.read-next__all { margin-top: var(--sp-8); }
</style>
