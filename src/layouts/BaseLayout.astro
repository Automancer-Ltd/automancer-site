---
import { createHash } from 'node:crypto';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import InlineScript from '../components/InlineScript.astro';
import { founderNode, organizationNode, websiteNode, webPageNode } from '../data/jsonld';
import { cardAlt, pageCardFor } from '../data/share-cards';
import { markdownTwinPath, staticPages } from '../data/site-content';
import { abs, pagePath } from '../data/urls';
import { build } from '../data/build';
import { documentTitle } from '../lib/meta';
import { OFFSITE_LOCK } from '../../ops/edge/worker.js';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/print.css';
import spaceGroteskUrl from '../assets/fonts/space-grotesk.woff2?url';
import syneUrl from '../assets/fonts/syne.woff2?url';

export interface Props {
  title: string;
  description: string;
  /** The page's share card; a hand-authored page's own card (pageCards) when left out. */
  image?: string;
  /** Alt text for `image` (og:image:alt, twitter:image:alt). */
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** Page-specific schema.org nodes merged into the shared @graph. */
  schema?: Record<string, unknown>[];
  /** WebPage subtype for structured data (ContactPage, AboutPage, …). */
  pageType?: string;
  /** Site path of this page's Markdown twin, where it is not a static page. */
  markdown?: string;
}

const { title, description, ogType = 'website', schema = [], pageType, markdown } = Astro.props;
// A field note or case study names its own card; every other page has one
// drawn from its own words (src/data/share-cards.ts), the 404 page home's.
const ownCard = Astro.props.image ? undefined : await pageCardFor(Astro.url.pathname);
const image = Astro.props.image ?? ownCard!.image;
const imageAlt = Astro.props.imageAlt ?? cardAlt(ownCard!.card);
// The GitHub Pages copy's lock (ops/edge/worker.js OFFSITE_LOCK, t23484), under its hash. Only a
// production build carries it: `astro dev` serves pages with no Worker in front to take it out.
const offsiteLock = import.meta.env.PROD ? OFFSITE_LOCK : '';
if (offsiteLock) {
  const css = /^<style>([^<]*)<\/style>$/.exec(offsiteLock)![1]!;
  Astro.csp!.insertStyleHash(`sha256-${createHash('sha256').update(css).digest('base64')}`);
}
const markdownUrl = markdown ? abs(markdown) : markdownTwinPath(Astro.url.pathname);

// A static page's JSON-LD type comes from its staticPages entry (the same one
// /api/pages.json publishes), limited to real schema.org WebPage subtypes:
// "PrivacyPolicy" there is this site's label, not a schema.org type.
const SCHEMA_PAGE_TYPES = new Set(['WebPage', 'AboutPage', 'ContactPage', 'CollectionPage']);
const listedType = staticPages.find((p) => pagePath(p.path) === pagePath(Astro.url.pathname))?.type;
const jsonLdType = pageType ?? (listedType && SCHEMA_PAGE_TYPES.has(listedType) ? listedType : undefined);

// Instant page-to-page navigation (Speculation Rules; docs/PERFORMANCE.md).
// When a visitor hovers a link to one of our pages (or presses it on a touch
// screen), the browser renders that page in the background, so the click shows
// it at once instead of waiting a round trip to GitHub Pages. Same origin only:
// no request goes anywhere a normal click would not. /contact/ is prerendered
// too: its third-party security check loads only after the page is seen and
// loaded (t21450), so rendering it in the background requests nothing from
// another site. Files (.md, .json, .txt, .xml, images) are never speculated.
// Browsers without support ignore it; src/scripts/prefetch.ts then fetches
// eligible links on mouse hover or after they stay on a touch screen (t23288, t24026).
const SPECULATION_RULES = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: '/*.*' } },
          { not: { selector_matches: '[download], [target=_blank], [rel~=nofollow]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: '/*.*' } },
          { not: { selector_matches: '[download], [target=_blank], [rel~=nofollow]' } },
        ],
      },
      eagerness: 'eager',
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Send anyone reading the GitHub Pages copy to automancer.uk (t23224). The edge Worker reads
      every file from automancer-ltd.github.io/automancer-site (t22925), so that address is public
      too, and there no Worker adds frame-ancestors, COOP or nosniff: any site could frame the
      full page, prices and Contact button included. On a *.github.io host this replaces the page
      with the same path on automancer.uk before anything is drawn; inside a stranger's frame it
      navigates the frame to automancer.uk, which refuses to be framed. Any other host (production,
      the preview target, localhost, a translation proxy) is left alone. It runs after the page's
      CSP meta (src/integrations/early-csp.ts puts that right after the viewport) under its hash.
      tests/off-site-guard.test.ts runs these exact bytes against each kind of address.
    */}
    <InlineScript><script is:inline>if(location.hostname.endsWith('.github.io'))location.replace('https://automancer.uk'+location.pathname.replace(/^\/automancer-site(?=\/|$)/,'')+location.search+location.hash)</script></InlineScript>
    {/*
      The lock (t23484): hides the page and says where it lives. The edge Worker takes it out of
      every page it serves, so it binds only on the GitHub Pages copy, where the script above can be
      switched off by a frame sandboxed without allow-scripts, which used to draw the full page.
      tests/off-site-guard.test.ts holds its place and bytes; tests/edge-worker.test.ts its removal.
    */}
    {offsiteLock && <Fragment set:html={offsiteLock} />}
    {/* Preload the two self-hosted fonts used above the fold on every page. */}
    <link rel="preload" href={spaceGroteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={syneUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#000000" />
    <meta name="is-agentic-site-type" content="business" />
    {/* The full commit this page was built from: deploy checks compare it with the commit shipped. */}
    {build.commitFull && <meta name="build-revision" content={build.commitFull} />}
    <SEO title={documentTitle(title)} description={description} image={image} imageAlt={imageAlt} type={ogType} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16.png" />
    <link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml" />

    <InlineScript><script type="speculationrules" is:inline set:html={JSON.stringify(SPECULATION_RULES)} /></InlineScript>

    <!-- One JSON-LD @graph per page: Organization + WebSite + this page,
          plus the founder Person node (referenced by @id from the
          organization and article nodes, so it must be described here),
          plus any page-specific nodes passed via the `schema` prop. -->
    <JsonLd
      nodes={[
        organizationNode(),
        websiteNode(),
        webPageNode({ path: Astro.url.pathname, title, description, type: jsonLdType, image, imageAlt }),
        founderNode(),
        ...schema,
      ]}
    />

    <!-- Page-specific head content, including Contact's inert Turnstile template. -->
    <slot name="head" />

    {/*
      NO browser-storage writes here, deliberately. A UTM-capture snippet used
      to persist utm_* from the landing URL for the contact form to attribute
      the lead. Removed 2026-08-22 (AUT-6414, Waseem's call as data
      controller): /privacy tells visitors our own site code "stores nothing in
      your browser" outside the disclosed contact-page security check, and
      campaign attribution is not strictly necessary under PECR, so the snippet
      made that claim false and was never consented to. Keeping the claim true
      was judged worth more than the attribution.
      If campaign attribution is ever wanted again it needs a consent
      mechanism first — do not reinstate it as a bare snippet.
      tests/no-browser-storage.test.ts enforces this.

      This is a server-side comment on purpose: an HTML comment would ship the
      note to every page and put the very strings that test greps for back
      into the output.
    */}

    {/*
      The page-load module, one file every page shares. First production-only browser error
      monitoring: the module itself requires PUBLIC_AUT_SENTRY_WEB_DSN, so preview/dev builds never
      emit events. Then the hover and touch-screen prefetch for browsers that ignore the
      Speculation Rules above (Firefox, Safari; src/scripts/prefetch.ts), and last what every page
      does once read (src/scripts/main.ts: reveals, the menu, the article contents; t26489). With
      monitoring on it lazily imports Sentry, so Astro writes it as a content-hashed /_astro/ file;
      without, it imports nothing and goes inline (assetsInlineLimit in astro.config.mjs).
    */}
    <script>
      import '../scripts/sentry';
      import '../scripts/prefetch';
      import '../scripts/main';
    </script>
  </head>
  <body data-print-url={abs(Astro.url.pathname)}>
    {/*
      Firefox draws text with a pending web font in its default font: it never starts a
      local() fallback face on its own, so every line re-wrapped when the fonts arrived there
      (t23013). Asking for the fallback faces here, once the head's styles are parsed and before
      any text, lets it use them like Chromium and Safari do (t23138). A face whose local font
      is not installed (Roboto on a Mac) simply fails to load. Nothing is fetched: local() only.
      A browser without document.fonts skips it.
    */}
    <InlineScript><script is:inline>document.fonts?.forEach(f=>{if(f.family.includes('Fallback'))f.load().catch(()=>{})})</script></InlineScript>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
